<!-- EMULATOR MODAL -->
<div id="emulator-modal" class="modal-back hidden">
  <div class="emu-window">
    <div class="emu-header">
      <div class="emu-title" id="emulator-title">Retro Arcade</div>
      <div class="emu-controls">
        <select id="emulator-core-select" class="nf-select" style="padding:5px 10px;font-size:12px;width:auto;border-radius:4px;">
          <option value="nes">NES</option><option value="snes">SNES</option><option value="n64">N64</option>
          <option value="segaMD">Sega Genesis</option><option value="segaCD">Sega CD</option>
          <option value="dreamcast">Dreamcast</option><option value="psx">PlayStation</option>
          <option value="gba">Game Boy Adv</option><option value="arcade">Arcade (MAME)</option>
        </select>
        <button class="emu-btn" onclick="document.getElementById('rom-file-input').click()">⬆ Upload ROM</button>
        <button class="emu-btn" onclick="toggleFullscreen()">⛶ Fullscreen</button>
        <button class="emu-btn close" onclick="closeEmulator()">✕ Close</button>
      </div>
    </div>
    <div id="emulator-container">
      <div class="emu-placeholder" id="emulator-placeholder">
        <div style="font-size:60px;">🕹️</div>
