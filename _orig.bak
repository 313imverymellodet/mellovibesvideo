          <button class="bb-play" id="detail-play" style="font-size:15px;padding:11px 26px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg> Play
          </button>
          <button class="bb-info" id="detail-trailer" style="display:none;font-size:14px;padding:11px 18px;">🎬 Trailer</button>
          <button class="detail-icon-btn" id="detail-fav" title="Add to My List">+</button>
          <button class="detail-icon-btn" id="detail-watched" title="Mark watched">✓</button>
          <button class="detail-icon-btn" id="detail-download" title="Download for offline" style="display:none;">⬇</button>
