        <div class="detail-extra" id="detail-extra"></div>
      </div>
      <div class="detail-tabpane" id="dtab-episodes"><div id="detail-episodes"></div></div>
      <div class="detail-tabpane" id="dtab-similar"><div class="detail-mini-scroll" id="detail-similar"></div></div>
      <div class="detail-tabpane" id="dtab-cast"><div class="cast-grid" id="detail-cast"></div></div>
      <div class="detail-tabpane" id="dtab-details"><div id="detail-details"></div></div>
    </div>
  </div>
</div>

<!-- TOAST -->
<div id="toast"><span id="toast-icon" class="toast-icon"></span><span id="toast-msg"></span></div>

<script>
// ═══════════════════════════
// DATA
// ═══════════════════════════
const GAME_LIBRARY = {
  nes:[{title:'Super Mario Bros',year:1985,players:'1-2',emoji:'🍄'},{title:'The Legend of Zelda',year:1986,players:'1',emoji:'🗡️'},{title:'Mega Man 2',year:1988,players:'1',emoji:'🤖'},{title:'Contra',year:1987,players:'1-2',emoji:'💥'},{title:'Castlevania',year:1986,players:'1',emoji:'🧛'},{title:'Duck Tales',year:1989,players:'1',emoji:'🦆'}],
  snes:[{title:'Super Mario World',year:1990,players:'1-2',emoji:'🌍'},{title:'Chrono Trigger',year:1995,players:'1',emoji:'⏱️'},{title:'Super Metroid',year:1994,players:'1',emoji:'👽'},{title:'Street Fighter II',year:1992,players:'1-2',emoji:'👊'},{title:'Final Fantasy VI',year:1994,players:'1',emoji:'⚔️'},{title:'Donkey Kong Country',year:1994,players:'1-2',emoji:'🦍'}],
  n64:[{title:'Super Mario 64',year:1996,players:'1',emoji:'⭐'},{title:'Zelda: Ocarina of Time',year:1998,players:'1',emoji:'🗡️'},{title:'GoldenEye 007',year:1997,players:'1-4',emoji:'🔫'},{title:'Mario Kart 64',year:1996,players:'1-4',emoji:'🏎️'},{title:'Banjo-Kazooie',year:1998,players:'1',emoji:'🐻'},{title:'Diddy Kong Racing',year:1997,players:'1-4',emoji:'🏁'}],
  segaMD:[{title:'Sonic the Hedgehog',year:1991,players:'1',emoji:'💨'},{title:'Streets of Rage',year:1991,players:'1-2',emoji:'🥊'},{title:'Phantasy Star IV',year:1993,players:'1',emoji:'🌌'},{title:'Altered Beast',year:1988,players:'1-2',emoji:'🐉'}],
  segaCD:[{title:'Sonic CD',year:1993,players:'1',emoji:'💿'},{title:'Night Trap',year:1992,players:'1',emoji:'🎬'}],
  dreamcast:[{title:'Jet Set Radio',year:2000,players:'1',emoji:'🛼'},{title:'Shenmue',year:1999,players:'1',emoji:'🥋'},{title:'Soul Calibur',year:1999,players:'1-2',emoji:'🗡️'},{title:'Crazy Taxi',year:1999,players:'1',emoji:'🚕'},{title:'RE: Code Veronica',year:2000,players:'1',emoji:'🧟'},{title:'Power Stone',year:1999,players:'1-2',emoji:'💎'}],
  psx:[{title:'Final Fantasy VII',year:1997,players:'1',emoji:'🌿'},{title:'Metal Gear Solid',year:1998,players:'1',emoji:'🐍'},{title:'Crash Bandicoot',year:1996,players:'1',emoji:'🦊'},{title:'Spyro the Dragon',year:1998,players:'1',emoji:'🐲'},{title:'Resident Evil 2',year:1998,players:'1',emoji:'🧟'},{title:"Tony Hawk's Pro Skater",year:1999,players:'1-2',emoji:'🛹'}],
  gba:[{title:'Pokemon FireRed',year:2004,players:'1',emoji:'🔥'},{title:'Metroid Fusion',year:2002,players:'1',emoji:'👾'},{title:'Golden Sun',year:2001,players:'1',emoji:'☀️'},{title:'Mario & Luigi: SS',year:2003,players:'1',emoji:'🍄'}],
  arcade:[{title:'Pac-Man',year:1980,players:'1',emoji:'👻'},{title:'Galaga',year:1981,players:'1',emoji:'🚀'},{title:'Mortal Kombat',year:1992,players:'1-2',emoji:'💀'},{title:'X-Men (1992)',year:1992,players:'1-6',emoji:'⚡'},{title:'Daytona USA',year:1994,players:'1',emoji:'🏁'},{title:'House of the Dead',year:1996,players:'1-2',emoji:'🔫'}],
};

const CONSOLE_NAMES = {nes:'NES',snes:'SNES',n64:'Nintendo 64',segaMD:'Sega Genesis',segaCD:'Sega CD',dreamcast:'Dreamcast',psx:'PlayStation',gba:'Game Boy Advance',arcade:'Arcade'};
const EMULATOR_CORES = {nes:'fceumm',snes:'snes9x',n64:'mupen64plus_next',segaMD:'genesis_plus_gx',segaCD:'genesis_plus_gx',dreamcast:'flycast',psx:'pcsx_rearmed',gba:'mgba',arcade:'mame2003'};

const APP = {
  currentUser:null, currentPage:'home', currentConsole:'nes',
  jellyfinToken: localStorage.getItem('jf_token')||null,
  jellyfinUserId: localStorage.getItem('jf_userId')||null,
  jellyfinUrl:null, jfMovies:[], jfShows:[],
  requests: [],
  hlsInstance:null, emulatorLoaded:false, currentItemId:null,
  jfResume: [], currentSeriesId: null, preSearchPage: null,
  playSession: null, featuredItems: [], libraryLoaded: false, connectAttempted: false,
  jfFavorites: [], detailItem: null, nowPlaying: null, nextEpisode: null,
  curPlay: null, jwt: localStorage.getItem('mv_jwt') || null,
  quality: localStorage.getItem('mv_quality') || '720', channels: []
};

// ═══════════════════════════
// ACCOUNTS — backed by the MelloVibes API on Railway
// ═══════════════════════════
const API_BASE = 'https://mellovibes-api-production.up.railway.app';
function deviceIdFor(username){ return 'mv-'+String(username).toLowerCase().replace(/[^a-z0-9]/g,''); }
function apiHeaders(){ return APP.jwt ? { 'Authorization':'Bearer '+APP.jwt } : {}; }

// ═══════════════════════════
// BILLBOARD FEATURED ITEMS
// ═══════════════════════════
const FEATURED = [
  {title:'Dune: Part Two',year:2024,genre1:'Sci-Fi',genre2:'Epic',rating:'98%',desc:'Paul Atreides unites with Chani and the Fremen while seeking revenge against the conspirators who destroyed his family.',emoji:'🏜️',navTo:'movies'},
  {title:'The Last of Us',year:2023,genre1:'Drama',genre2:'Thriller',rating:'99%',desc:'A hardened survivor and a teenage girl navigate a post-apocalyptic America filled with infected creatures and desperate survivors.',emoji:'🍄',navTo:'tv'},
  {title:'Oppenheimer',year:2023,genre1:'Drama',genre2:'History',rating:'95%',desc:'The story of J. Robert Oppenheimer and his role in the development of the atomic bomb during World War II.',emoji:'💥',navTo:'movies'},
  {title:'Attack on Titan',year:2013,genre1:'Anime',genre2:'Action',rating:'99%',desc:'In a world threatened by giant humanoid creatures, Eren Yeager vows to exterminate every last one of them.',emoji:'⚔️',navTo:'tv'},
  {title:'Retro Arcade',year:null,genre1:'Games',genre2:'Classics',rating:'100%',desc:'Over 60 classic games from NES, SNES, N64, Sega, PlayStation, and more — all playable right in your browser.',emoji:'🕹️',navTo:'arcade'},
];
let bbIndex = 0, bbTimer = null;

// Per-account Jellyfin device identity (so "Now Watching" can tell people apart)
APP.deviceId = 'mellohaven-1';

// ── ROM library (hosted on the user's server) ──
APP.romBase = localStorage.getItem('rom_base') || '';
const CAN_HOVER = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
const ROM_EXT = {nes:'nes',snes:'sfc',n64:'z64',segaMD:'md',segaCD:'chd',dreamcast:'chd',psx:'chd',gba:'gba',arcade:'zip'};
function romSlug(t){ return String(t).toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,''); }
function romFilename(consoleKey,title){ return `${romSlug(title)}.${ROM_EXT[consoleKey]||'bin'}`; }
function romUrlFor(consoleKey,title){ return APP.romBase ? `${APP.romBase.replace(/\/+$/,'')}/${consoleKey}/${romFilename(consoleKey,title)}` : null; }

// ═══════════════════════════
// LOGIN
// ═══════════════════════════
function switchLoginTab(tab) {
  document.querySelectorAll('.nf-tab').forEach(t => t.classList.remove('active'));
  event.target.classList.add('active');
  document.getElementById('signin-form').classList.toggle('hidden', tab!=='signin');
  document.getElementById('signup-form').classList.toggle('hidden', tab!=='signup');
  document.getElementById('login-error').classList.add('hidden');
  const h=document.querySelector('.login-h'); if(h) h.textContent = tab==='signup' ? 'Create Account' : 'Sign In';
}

function loginError(msg){ const e=document.getElementById('login-error'); e.textContent=msg; e.classList.remove('hidden'); }

// "Who's watching?" — remember accounts used on this device for one-tap switching
function knownUsers(){ try{ return JSON.parse(localStorage.getItem('mv_known_users')||'[]'); }catch(e){ return []; } }
function rememberUser(u){
  const list = knownUsers().filter(x=>x.u!==u.username);
  list.unshift({u:u.username, n:u.name});
  localStorage.setItem('mv_known_users', JSON.stringify(list.slice(0,5)));
}
function renderProfileRow(){
  const row=document.getElementById('profile-row'); if(!row) return;
  const list=knownUsers();
  if(!list.length){ row.style.display='none'; return; }
  row.style.display='flex';
  row.innerHTML='<div class="profile-row-label">Who\u2019s watching?</div><div class="profile-row-faces">'+list.map(p=>{
    const hue=_hashHue(p.u);
    return `<div class="profile-face" onclick="pickProfile('${p.u.replace(/'/g,"\\'")}')">
      <div class="profile-circle" style="background:linear-gradient(135deg, hsl(${hue} 60% 45%), hsl(${(hue+40)%360} 55% 35%));">${escHtml(p.n[0].toUpperCase())}</div>
      <div class="profile-name">${escHtml(p.n)}</div></div>`;
  }).join('')+'</div>';
}
function pickProfile(username){
  document.getElementById('login-user').value=username;
  document.getElementById('login-pass').value='';
  document.getElementById('login-pass').focus();
}

function enterApp(user){
  rememberUser(user);
  APP.currentUser = user;
  APP.deviceId = deviceIdFor(user.username);
  document.getElementById('login-error').classList.add('hidden');
  document.getElementById('login-screen').classList.add('hidden');
  document.getElementById('app').classList.remove('hidden');
  document.getElementById('nav-avatar-initials').textContent = user.name[0].toUpperCase();
  document.getElementById('avatar-menu-name').textContent = user.name;
  document.querySelectorAll('.avatar-role').forEach(el=>el.textContent=user.role||'Member');
  document.getElementById('settings-display-name').textContent = user.name;
  try{ history.replaceState({page:'home'},''); }catch(e){}
  renderAll(); autoConnectJellyfin(); initBillboard(); applyAvatarColor(); loadRequests();
  { const a=document.getElementById('avatar-analytics'); if(a) a.style.display=isAdmin()?'':'none'; }
}

function setSession(data){
  APP.jwt = data.token;
  localStorage.setItem('mv_jwt', data.token);
  localStorage.setItem('mv_user', JSON.stringify(data.user));
}

async function doLogin() {
  const u = document.getElementById('login-user').value.trim().toLowerCase();
  const p = document.getElementById('login-pass').value;
  if (!u || !p) { loginError('Enter your username and password.'); return; }
  try {
    const r = await fetch(`${API_BASE}/api/login`, {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ username:u, password:p })
    });
    const d = await r.json();
    if (!r.ok) { loginError(d.error || 'Incorrect username or password.'); return; }
    setSession(d); enterApp(d.user); toast(`Welcome back, ${d.user.name}!`);
  } catch(e) { loginError('Can’t reach the server. Try again in a moment.'); }
}

async function doSignup() {
  const name = document.getElementById('su-name').value.trim();
  const user = document.getElementById('su-user').value.trim().toLowerCase();
  const pass = document.getElementById('su-pass').value;
  const code = document.getElementById('su-code').value.trim().toUpperCase();
  if (!name || !user || !pass || !code) { loginError('Please fill in every field.'); return; }
  try {
    const r = await fetch(`${API_BASE}/api/signup`, {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ name, username:user, password:pass, code })
    });
    const d = await r.json();
    if (!r.ok) { loginError(d.error || 'Could not create account.'); return; }
    setSession(d); enterApp(d.user); toast(`Welcome to MelloVibes, ${d.user.name}!`);
  } catch(e) { loginError('Can’t reach the server. Try again in a moment.'); }
}

['login-pass','login-user'].forEach(id=>document.getElementById(id).addEventListener('keydown', e => { if(e.key==='Enter') doLogin(); }));
['su-name','su-user','su-pass','su-code'].forEach(id=>document.getElementById(id).addEventListener('keydown', e => { if(e.key==='Enter') doSignup(); }));

function doLogout() {
  APP.currentUser=null; APP.jwt=null;
  localStorage.removeItem('mv_jwt'); localStorage.removeItem('mv_user');
  clearInterval(bbTimer); bbTimer=null; stopPresence();
  APP.libraryLoaded=false; APP.connectAttempted=false;
  document.getElementById('login-screen').classList.remove('hidden');
  document.getElementById('app').classList.add('hidden');
  renderProfileRow();
  closeMobileMenu();
}

// Auto-login if we already have a valid session token (cross-device: log in once per device)
async function tryAutoLogin(){
  if (!APP.jwt) return;
  try {
    const r = await fetch(`${API_BASE}/api/me`, { headers: apiHeaders() });
    if (r.ok) { const d = await r.json(); enterApp(d.user); }
    else { APP.jwt=null; localStorage.removeItem('mv_jwt'); }
  } catch(e) { /* offline — stay on login screen */ }
}
renderProfileRow();
tryAutoLogin();

// ═══════════════════════════
// NAVIGATION
// ═══════════════════════════
function navigate(page) {
  APP.currentPage = page;
  APP.preSearchPage = null;
  document.getElementById('search-input').value = '';
  document.querySelectorAll('.page').forEach(p => p.classList.add('hidden'));
  document.querySelectorAll('.nav-link').forEach(n => n.classList.remove('active'));
  const pageEl = document.getElementById('page-'+page);
  const navEl = document.getElementById('nav-'+page);
  if (pageEl) pageEl.classList.remove('hidden');
  if (navEl) navEl.classList.add('active');
  const loading = !APP.connectAttempted && !APP.libraryLoaded;
  if (page==='movies') { if(loading) document.getElementById('movies-grid').innerHTML=skeletonGrid(18); else if(APP.jfMovies&&APP.jfMovies.length) renderJellyfinGrid('movies-grid',APP.jfMovies); else document.getElementById('movies-grid').innerHTML=serverDownHtml(); }
  if (page==='tv') { if(loading) document.getElementById('tv-grid').innerHTML=skeletonGrid(18); else if(APP.jfShows&&APP.jfShows.length) renderJellyfinGrid('tv-grid',APP.jfShows); else document.getElementById('tv-grid').innerHTML=serverDownHtml(); }
  if (page==='browse') buildBrowse();
  if (page==='livetv') loadChannels();
  if (page==='arcade') renderGamesGrid(APP.currentConsole);
  if (page==='requests') { renderRequestsList(); loadRequests(); }
  if (page==='settings') {
    checkJellyfinStatus();
    const rs=document.getElementById('rom-status'); if(rs) rs.textContent=APP.romBase?('✓ Library: '+APP.romBase):'No ROM library set — games will ask you to upload a ROM';
    const ri=document.getElementById('rom-base-input'); if(ri&&APP.romBase) ri.placeholder=APP.romBase;
    restoreSettingToggles();
    try{ const t=JSON.parse(localStorage.getItem('mv_theme')||'null'); const c=t?t[0]:'#E50914'; document.querySelectorAll('.theme-swatch').forEach(s=>s.classList.toggle('active', s.dataset.color===c)); }catch(e){}
  }
  if (page==='stats') renderStats();
  if (page==='analytics') renderAnalytics();
  // scroll to top
  document.getElementById('pages').scrollTop = 0;
  if (!APP._suppressPush) pushHistory({page});
}

// Scroll-based nav background
document.getElementById('pages').addEventListener('scroll', function() {
  document.getElementById('topnav').classList.toggle('scrolled', this.scrollTop > 60);
});

// ═══════════════════════════
// CARD CREATION
// ═══════════════════════════
// Deterministic gradient + icon for items with no poster art (replaces blank boxes)
function _hashHue(s){ let h=0; for(let i=0;i<s.length;i++) h=(h*31+s.charCodeAt(i))%360; return h; }
function posterGradient(s){ const h=_hashHue(s||''); return `linear-gradient(145deg, hsl(${h} 42% 15%), hsl(${(h+45)%360} 48% 8%))`; }

function createJellyfinCard(item, opts={}) {
  const imgUrl = `${APP.jellyfinUrl}/Items/${item.Id}/Images/Primary?api_key=${APP.jellyfinToken}&maxWidth=300&quality=80`;
  const year = item.ProductionYear||'';
  const rating = item.CommunityRating ? item.CommunityRating.toFixed(1) : '';
  const isSeries = item.Type === 'Series';
  const userData = item.UserData || {};
  const resume = (!isSeries && userData.PlaybackPositionTicks) ? userData.PlaybackPositionTicks : 0;
  const safeName = item.Name.replace(/'/g,"\\'");
  const playAction = isSeries
    ? `openEpisodePicker('${item.Id}','${safeName}')`
    : `openJellyfinItem('${item.Id}','${item.Type}','${safeName}',${resume})`;
  const favActive = userData.IsFavorite ? ' active' : '';
  const pct = userData.PlayedPercentage || 0;
  const progressHtml = pct > 0 && pct < 100
    ? `<div class="nf-progress"><div class="nf-progress-fill" style="width:${pct}%"></div></div>` : '';
  const removeBtn = opts.removable
    ? `<button class="nf-remove" title="Remove from Continue Watching" onclick="event.stopPropagation(); removeFromContinue('${item.Id}', this)">✕</button>` : '';
  return `
    <div class="nf-card" onclick="openDetail('${item.Id}')">
      <div class="nf-card-thumb" style="background:${posterGradient(item.Name)};">
        ${removeBtn}
        <div class="nf-poster-fallback">${isSeries?'📺':'🎬'}</div>
        <img src="${imgUrl}" alt="${item.Name}" loading="lazy" style="width:100%;height:100%;object-fit:cover;position:absolute;inset:0;z-index:1;" onerror="this.style.display='none'">
        ${(CAN_HOVER&&item.BackdropImageTags&&item.BackdropImageTags.length)?`<img class="nf-card-backdrop" src="${APP.jellyfinUrl}/Items/${item.Id}/Images/Backdrop/0?api_key=${APP.jellyfinToken}&maxWidth=400&quality=75" loading="lazy" onload="this.classList.add('ready')" onerror="this.remove()">`:''}
        <div class="card-shade"></div>
        <div class="card-title-overlay">${item.Name}</div>
        ${progressHtml}
      </div>
      <div class="nf-card-hover">
        <div class="card-hover-actions">
          <div class="ch-btn play" onclick="event.stopPropagation(); ${playAction}"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg></div>
          <div class="ch-btn ch-btn-add${favActive}" title="My List" onclick="event.stopPropagation(); toggleFavorite('${item.Id}', this)"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></div>
          <div class="ch-btn" title="More info" onclick="event.stopPropagation(); openDetail('${item.Id}')"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg></div>
        </div>
        <div class="card-hover-title">${item.Name}</div>
        <div class="card-hover-meta">
          ${rating?`<span class="ch-match">⭐ ${rating}</span>`:''}
          <span class="ch-year">${year}</span>
          ${(item.Genres&&item.Genres[0])?`<span class="ch-rating">${item.Genres[0]}</span>`:''}
          ${isSeries?`<span class="ch-hd">SERIES</span>`:`<span class="ch-hd">HD</span>`}
        </div>
      </div>
    </div>`;
}

// ═══════════════════════════
// RENDER
// ═══════════════════════════
function skeletonRow(n){ return Array.from({length:n},()=>'<div class="skel-card"></div>').join(''); }
function skeletonGrid(n){ return Array.from({length:n},()=>'<div class="skel-card" style="width:100%;"></div>').join(''); }

function renderAll() {
  // While the first Jellyfin connection is in flight, show skeletons instead of
  // flashing demo titles that get swapped a moment later.
  if (!APP.connectAttempted && !APP.libraryLoaded) {
    ['home-continue-row','home-movies-row','home-shows-row'].forEach(id=>{
      const el=document.getElementById(id); if(el){ el.innerHTML=skeletonRow(7); el.closest('.row').style.display=''; }
    });
    renderHomeGames();
    updateRequestsBadge();
    return;
  }

  const useJf = APP.jfMovies.length || APP.jfShows.length;

  // ── Continue Watching ──
  const continueEl = document.getElementById('home-continue-row');
  const continueRow = continueEl.closest('.row');
  if (APP.jfResume.length) {
    continueEl.innerHTML = APP.jfResume.map(i => createJellyfinCard(i, {removable:true})).join('');
    continueRow.style.display = '';
  } else { continueRow.style.display = 'none'; }

  // ── Movies row ──
  if (APP.jfMovies.length) { document.getElementById('home-movies-row').innerHTML = APP.jfMovies.slice(0,10).map(i=>createJellyfinCard(i)).join(''); }
  else { document.getElementById('home-movies-row').innerHTML = serverDownHtml(); }

  // ── Shows row ──
  if (APP.jfShows.length) { document.getElementById('home-shows-row').innerHTML = APP.jfShows.slice(0,10).map(i=>createJellyfinCard(i)).join(''); }
  else { document.getElementById('home-shows-row').innerHTML = serverDownHtml(); }

  // ── My List (favorites) ──
  const mylistRow = document.getElementById('home-mylist-row');
  if (APP.jfFavorites.length) {
    document.getElementById('home-mylist-scroll').innerHTML = APP.jfFavorites.map(i=>createJellyfinCard(i)).join('');
    mylistRow.style.display = '';
  } else { mylistRow.style.display = 'none'; }

  // ── Genre rows ──
  renderGenreRows();

  renderHomeGames();
  updateRequestsBadge();
}

// Build "Action / Comedy / Horror…" rows from the real library
function renderGenreRows() {
  const container = document.getElementById('home-genre-sections');
  if (!container) return;
  if (!APP.jfMovies.length && !APP.jfShows.length) { container.innerHTML=''; return; }
  const all = [...APP.jfMovies, ...APP.jfShows];
  const byGenre = {};
  all.forEach(item => (item.Genres||[]).forEach(g => { (byGenre[g] = byGenre[g] || []).push(item); }));
  // Top genres with at least 4 titles, max 6 rows
  const genres = Object.keys(byGenre).filter(g => byGenre[g].length >= 4)
    .sort((a,b) => byGenre[b].length - byGenre[a].length).slice(0,6);
  container.innerHTML = genres.map(g => `
    <div class="row">
      <div class="row-title">${escHtml(g)}</div>
      <div class="row-scroll">${byGenre[g].slice(0,14).map(i=>createJellyfinCard(i)).join('')}</div>
    </div>`).join('');
}

function renderHomeGames() {
  const games = [...GAME_LIBRARY.nes.slice(0,2),...GAME_LIBRARY.snes.slice(0,2),...GAME_LIBRARY.dreamcast.slice(0,2),...GAME_LIBRARY.psx.slice(0,2)];
  document.getElementById('home-games-row').innerHTML = games.map(g=>`
    <div class="nf-card" onclick="navigate('arcade')" style="width:160px;">
      <div class="nf-card-thumb" style="aspect-ratio:4/3;background:linear-gradient(135deg,#1a0510,#0a1020);">
        <div style="font-size:42px;display:flex;align-items:center;justify-content:center;height:100%;position:relative;z-index:1;">${g.emoji}</div>
        <div class="card-shade"></div>
        <div class="card-title-overlay">${g.title}</div>
      </div>
      <div class="nf-card-hover">
        <div class="card-hover-actions"><div class="ch-btn play"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg></div></div>
        <div class="card-hover-title">${g.title}</div>
        <div class="card-hover-meta"><span class="ch-year">${g.year}</span><span class="ch-rating">${g.players}P</span></div>
      </div>
    </div>`).join('');
}

function renderJellyfinGrid(id, items) {
  const el = document.getElementById(id);
  if (!items||!items.length) { el.innerHTML='<div class="empty"><div class="empty-icon">📭</div><h3>No items found</h3></div>'; return; }
  el.innerHTML = items.map(i=>createJellyfinCard(i,'jf')).join('');
}

function renderGamesGrid(key) {
  const games = GAME_LIBRARY[key]||[];
  document.getElementById('console-section-title').textContent = CONSOLE_NAMES[key]+' Games';
  document.getElementById('games-grid').innerHTML = games.map(g=>`
    <div class="game-card" onclick="openGame('${key}','${g.title.replace(/'/g,"\\'")}')">
      <div class="game-thumb">
        <span style="position:relative;z-index:1;">${g.emoji}</span>
        <div class="game-hover-overlay"><div style="width:44px;height:44px;background:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;"><svg width="16" height="16" viewBox="0 0 24 24" fill="#000"><polygon points="5 3 19 12 5 21 5 3"/></svg></div></div>
      </div>
      <div class="game-info">
        <div class="game-title">${g.title}</div>
        <div class="game-meta">${g.year} · ${g.players} Player${g.players!=='1'?'s':''}</div>
      </div>
    </div>`).join('');
}

function isAdmin(){ return APP.currentUser && /admin/i.test(APP.currentUser.role||''); }

function renderRequestsList() {
  const el = document.getElementById('requests-list');
  const typeEmoji={movie:'🎬',tv:'📺',anime:'⚔️',documentary:'🎥'};
  const admin=isAdmin();
  const mine = (APP.currentUser?.username||'').toLowerCase();
  const rows = APP.requests.map(r=>{
    const owned = admin || (r.username||'').toLowerCase()===mine;
    const adminControls = (admin || owned) ? `
      <div class="req-admin-actions">
        ${admin && r.status!=='approved'?`<button class="req-act approve" onclick="setRequestStatus(${r.id},'approved')">Approve</button>`:''}
        ${admin && r.status!=='added'?`<button class="req-act added" onclick="setRequestStatus(${r.id},'added')">Mark Added</button>`:''}
        ${owned?`<button class="req-act deny" onclick="deleteRequest(${r.id})">Delete</button>`:''}
      </div>` : '';
    return `
    <div class="req-row">
      <div class="req-icon">${typeEmoji[r.type]||'🎬'}</div>
      <div class="req-info">
        <div class="req-name">${escHtml(r.title)}</div>
        <div class="req-detail">${r.type} · ${r.priority} priority · ${escHtml(r.user)} · ${r.date}</div>
        ${r.notes?`<div class="req-detail" style="font-style:italic;margin-top:2px;">"${escHtml(r.notes)}"</div>`:''}
        ${adminControls}
      </div>
      <span class="req-badge ${r.status}">${r.status}</span>
    </div>`;}).join('');
  el.innerHTML = `<div class="req-list-header">All Requests (${APP.requests.length})${admin?' · <span style="color:var(--text3);font-weight:400;">Admin controls enabled</span>':''}</div>` + (rows||'<div class="empty"><div class="empty-icon">📭</div><h3>No requests yet</h3></div>');
}

// Load everyone's requests from the API (shared family-wide)
async function loadRequests(){
  if(!APP.jwt) return;
  try{
    const r=await fetch(`${API_BASE}/api/requests`,{headers:apiHeaders()});
    if(r.ok){ const d=await r.json(); APP.requests=d.requests||[]; renderRequestsList(); updateRequestsBadge(); }
  }catch{}
}
async function setRequestStatus(id, status){
  try{
    const r=await fetch(`${API_BASE}/api/requests/${id}`,{method:'PATCH',headers:{'Content-Type':'application/json',...apiHeaders()},body:JSON.stringify({status})});
    const d=await r.json();
    if(!r.ok){ toast(d.error||'Could not update','error'); return; }
    const it=APP.requests.find(x=>x.id===id); if(it) it.status=status;
    renderRequestsList(); updateRequestsBadge();
    toast(`Marked ${status}`);
  }catch{ toast('Can’t reach the server','error'); }
}
async function deleteRequest(id){
  try{
    const r=await fetch(`${API_BASE}/api/requests/${id}`,{method:'DELETE',headers:apiHeaders()});
    if(!r.ok){ const d=await r.json().catch(()=>({})); toast(d.error||'Could not delete','error'); return; }
    APP.requests=APP.requests.filter(x=>x.id!==id);
    renderRequestsList(); updateRequestsBadge();
    toast('Request deleted','info');
  }catch{ toast('Can’t reach the server','error'); }
}

function updateRequestsBadge() {
  const pending = APP.requests.filter(r=>r.status==='pending').length;
  const badge = document.getElementById('requests-badge');
  const mobBadge = document.getElementById('mob-requests-badge');
  if (badge) { badge.textContent=pending; badge.style.display=pending>0?'':'none'; }
  if (mobBadge) { mobBadge.textContent=pending; mobBadge.style.display=pending>0?'':'none'; }
}

// ═══════════════════════════
// MEDIA ACTIONS
// ═══════════════════════════
function closeVideo() {
  const v = document.getElementById('main-video-player');
  stopPlaybackReporting(); // report stop + refresh Continue Watching
  cancelUpNext();
  APP.intro=null; v.ontimeupdate=null;
  const sk=document.getElementById('skip-intro-btn'); if(sk) sk.classList.remove('show');
  v.pause(); v.src=''; v.style.display='none';
  if (APP.hlsInstance) { APP.hlsInstance.destroy(); APP.hlsInstance=null; }
  document.getElementById('video-prompt').style.display='flex';
  document.getElementById('subtitle-bar').style.display='none';
  const _pui2=document.getElementById('player-ui'); if(_pui2) _pui2.style.display='none';
  document.getElementById('video-modal').classList.add('hidden');
}

// Filter the REAL library by genre (matches Jellyfin genre names loosely)
function genreMatches(item, key) {
  if (key === 'all') return true;
  const gs = (item.Genres || []).map(g => g.toLowerCase());
  if (key === 'scifi') return gs.some(g => /sci|science/.test(g));
  if (key === 'anime') return gs.some(g => /anime|animation/.test(g));
  return gs.some(g => g.includes(key));
}
function filterMedia(el, genre) {
  el.closest('.filter-bar').querySelectorAll('.chip').forEach(c=>c.classList.remove('active'));
  el.classList.add('active');
  if (APP.currentPage==='movies') renderJellyfinGrid('movies-grid', APP.jfMovies.filter(i=>genreMatches(i,genre)));
  else renderJellyfinGrid('tv-grid', APP.jfShows.filter(i=>genreMatches(i,genre)));
}

// ═══════════════════════════
// BROWSE (genre / decade / studio)
// ═══════════════════════════
function decadeOf(y){ return y ? (Math.floor(y/10)*10)+'s' : null; }
function chipRow(containerId, dim, options){
  const sel = APP.browseSel[dim];
  document.getElementById(containerId).innerHTML =
    [['all','All'], ...options].map(([val,label]) =>
      `<button class="chip${sel===val?' active':''}" onclick="browseSelect('${dim}','${String(val).replace(/'/g,"\\'")}',this)">${escHtml(label)}</button>`
    ).join('');
}
function buildBrowse(){
  if(!APP.browseSel) APP.browseSel = {type:'all', genre:'all', decade:'all', studio:'all'};
  const all = [...APP.jfMovies, ...APP.jfShows];
  if(!all.length){ document.getElementById('browse-grid').innerHTML = serverDownHtml(); return; }
  // Tally options by frequency so the most useful chips come first
  const tally = (arr) => { const m={}; arr.forEach(v=>{ if(v) m[v]=(m[v]||0)+1; }); return Object.entries(m).sort((a,b)=>b[1]-a[1]); };
  const genres  = tally(all.flatMap(i=>i.Genres||[])).slice(0,16).map(([g])=>[g.toLowerCase(),g]);
  const decades = [...new Set(all.map(i=>decadeOf(i.ProductionYear)).filter(Boolean))].sort().reverse().map(d=>[d,d]);
  const studios = tally(all.flatMap(i=>(i.Studios||[]).map(s=>s.Name))).slice(0,12).map(([s])=>[s,s]);
  chipRow('browse-type','type',[['movie','Movies'],['series','TV Shows']]);
  chipRow('browse-genre','genre',genres);
  chipRow('browse-decade','decade',decades);
  chipRow('browse-studio','studio',studios);
  applyBrowse();
}
function browseSelect(dim, val, el){
  APP.browseSel[dim] = val;
  if(el){ el.parentElement.querySelectorAll('.chip').forEach(c=>c.classList.remove('active')); el.classList.add('active'); }
  applyBrowse();
}
function applyBrowse(){
  const s = APP.browseSel;
  let pool = s.type==='movie' ? APP.jfMovies : s.type==='series' ? APP.jfShows : [...APP.jfMovies,...APP.jfShows];
  const out = pool.filter(i =>
    (s.genre==='all'  || genreMatches(i, s.genre)) &&
    (s.decade==='all' || decadeOf(i.ProductionYear)===s.decade) &&
    (s.studio==='all' || (i.Studios||[]).some(st=>st.Name===s.studio))
  );
  document.getElementById('browse-count').textContent = `${out.length} title${out.length!==1?'s':''}`;
  document.getElementById('browse-grid').innerHTML = out.length
    ? out.map(i=>createJellyfinCard(i)).join('')
    : '<div class="empty" style="grid-column:1/-1;"><div class="empty-icon">🔍</div><h3>Nothing matches those filters</h3></div>';
}

// ═══════════════════════════
// LIVE TV
// ═══════════════════════════
// Jellyfin doesn't expose channel categories, so we pull them from the source M3U's
// group-title and map channel name → a clean bucket. Configurable in Settings later.
const LIVETV_M3U = localStorage.getItem('mv_livetv_m3u') || 'https://raw.githubusercontent.com/BuddyChewChew/app-m3u-generator/refs/heads/main/playlists/tubi_all.m3u';
const CAT_BUCKETS = [
  [/sport/i,'Sports'], [/news/i,'News'], [/movie/i,'Movies'], [/comedy/i,'Comedy'],
  [/reality|competition|games/i,'Reality'], [/crime|mystery/i,'Crime'],
  [/sci-?fi|supernatural|horror|fantasy/i,'Sci-Fi'], [/kids|family|cartoon/i,'Kids'],
  [/español|spanish|latino/i,'Español'], [/black entertainment|urban/i,'Black TV'],
  [/lifestyle|good eats|home|food|travel/i,'Lifestyle'], [/music|pop culture/i,'Music & Pop'],
  [/drama|classic/i,'Drama'], [/science|nature/i,'Science'], [/anime/i,'Anime']
];
function bucketFor(group){ for(const [re,name] of CAT_BUCKETS) if(re.test(group||'')) return name; return 'More'; }

async function loadChannelCategories(){
  if(APP.chCat) return; // once per session
  APP.chCat = {};
  try{
    const txt = await (await fetch(LIVETV_M3U)).text();
    // Each channel: #EXTINF:-1 ... group-title="X",Channel Name
    txt.split('\n').forEach(line=>{
      if(!line.startsWith('#EXTINF')) return;
      const g=line.match(/group-title="([^"]*)"/);
      const name=line.split(',').slice(1).join(',').trim();
      if(name) APP.chCat[name.toLowerCase()] = bucketFor(g?g[1]:'');
    });
  }catch{ APP.chCat = {}; }
}
function catOf(ch){ return (APP.chCat && APP.chCat[(ch.Name||'').toLowerCase()]) || 'More'; }

// Fetch channels once, cache on APP.channels (shared by home row + full page)
async function ensureChannels(force){
  if(APP.channels && APP.channels.length && !force) { loadChannelCategories(); return true; }
  if(!APP.jellyfinToken) return false;
  try{
    const [chRes] = await Promise.all([
      fetch(`${APP.jellyfinUrl}/LiveTv/Channels?userId=${APP.jellyfinUserId}&EnableImages=true&Fields=CurrentProgram&Limit=500`,{headers:jfHeaders()}),
      loadChannelCategories()
    ]);
    if(!chRes.ok) return false;
    const d=await chRes.json(); APP.channels=d.Items||[]; return true;
  }catch{ return false; }
}
async function loadChannels(force){
  const grid=document.getElementById('channel-grid');
  if(!APP.jellyfinToken){ grid.innerHTML=serverDownHtml(); return; }
  if(!(APP.channels && APP.channels.length) || force){ grid.innerHTML=skeletonGrid(12); }
  const ok=await ensureChannels(force);
  if(!ok && !(APP.channels||[]).length){ grid.innerHTML='<div class="empty" style="grid-column:1/-1;"><div class="empty-icon">📡</div><h3>No live channels</h3><p style="font-size:13px;color:var(--text2);">Add an M3U tuner in Jellyfin → Live TV.</p></div>'; return; }
  buildChannelCats();
  applyLiveFilters();
}
function buildChannelCats(){
  const bar=document.getElementById('livetv-cats'); if(!bar) return;
  if(!APP.liveFilter) APP.liveFilter={q:'',cat:'all'};
  // Only show category buckets that actually have channels, ordered by count
  const tally={}; APP.channels.forEach(c=>{ const k=catOf(c); tally[k]=(tally[k]||0)+1; });
  const cats=Object.entries(tally).sort((a,b)=>b[1]-a[1]).map(([c])=>c);
  bar.innerHTML=[['all','All'],...cats.map(c=>[c,c])].map(([v,l])=>
    `<button class="chip${APP.liveFilter.cat===v?' active':''}" onclick="liveCat('${String(v).replace(/'/g,"\\'")}',this)">${escHtml(l)}</button>`
  ).join('');
}
function liveCat(cat, el){
  APP.liveFilter.cat=cat;
  if(el){ el.parentElement.querySelectorAll('.chip').forEach(c=>c.classList.remove('active')); el.classList.add('active'); }
  applyLiveFilters();
}
function applyLiveFilters(){
  if(!APP.liveFilter) APP.liveFilter={q:'',cat:'all'};
  const {q,cat}=APP.liveFilter;
  const out=APP.channels.filter(c=>
    (cat==='all' || catOf(c)===cat) &&
    (!q || (c.Name||'').toLowerCase().includes(q))
  );
  renderChannels(out);
}

// Home page "Live TV" row (a handful of channels)
async function renderHomeLiveTV(){
  const row=document.getElementById('home-livetv-row'); if(!row) return;
  const ok=await ensureChannels();
  if(!ok || !APP.channels.length){ row.style.display='none'; return; }
  const scroll=document.getElementById('home-livetv-scroll');
  scroll.innerHTML=APP.channels.slice(0,16).map(c=>{
    const safe=(c.Name||'').replace(/'/g,"\\'");
    const logo=(c.ImageTags&&c.ImageTags.Primary)
      ? `<img src="${APP.jellyfinUrl}/Items/${c.Id}/Images/Primary?api_key=${APP.jellyfinToken}&maxWidth=300&quality=90" alt="${escHtml(c.Name||'')}" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"><div class="channel-fallback" style="display:none;">${escHtml(c.Name||'')}</div>`
      : `<div class="channel-fallback">${escHtml(c.Name||'')}</div>`;
    const now=(c.CurrentProgram&&c.CurrentProgram.Name)?`<div class="channel-now">● ${escHtml(c.CurrentProgram.Name)}</div>`:'<div class="channel-now">&nbsp;</div>';
    return `<div class="channel-card" style="flex-shrink:0;width:190px;" onclick="playChannel('${c.Id}','${safe}')">
      <div class="channel-logo"><span class="ch-live">LIVE</span>${logo}</div>
      <div class="channel-info"><div class="channel-name">${escHtml(c.Name||'Channel')}</div>${now}</div>
    </div>`;
  }).join('');
  row.style.display='';
}
function renderChannels(list){
  const grid=document.getElementById('channel-grid');
  const total=APP.channels.length, showing=list.length;
  document.getElementById('livetv-count').textContent = showing===total ? `${total} channels` : `${showing} of ${total} channels`;
  if(!list.length){ grid.innerHTML='<div class="empty" style="grid-column:1/-1;"><div class="empty-icon">🔍</div><h3>No channels match</h3></div>'; return; }
  grid.innerHTML=list.map(c=>{
    const safe=(c.Name||'').replace(/'/g,"\\'");
    const logo=(c.ImageTags&&c.ImageTags.Primary)
      ? `<img src="${APP.jellyfinUrl}/Items/${c.Id}/Images/Primary?api_key=${APP.jellyfinToken}&maxWidth=300&quality=90" alt="${escHtml(c.Name||'')}" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"><div class="channel-fallback" style="display:none;">${escHtml(c.Name||'')}</div>`
      : `<div class="channel-fallback">${escHtml(c.Name||'')}</div>`;
    const now=(c.CurrentProgram&&c.CurrentProgram.Name)?`<div class="channel-now">● ${escHtml(c.CurrentProgram.Name)}</div>`:'<div class="channel-now">&nbsp;</div>';
    return `<div class="channel-card" onclick="playChannel('${c.Id}','${safe}')">
      <div class="channel-logo"><span class="ch-live">LIVE</span>${logo}</div>
      <div class="channel-info"><div class="channel-name">${escHtml(c.Name||'Channel')}</div>${now}</div>
    </div>`;
  }).join('');
}
function filterChannels(q){
  if(!APP.liveFilter) APP.liveFilter={q:'',cat:'all'};
  APP.liveFilter.q=(q||'').toLowerCase().trim();
  applyLiveFilters();
}
function playChannel(id, name){ openJellyfinItem(id, 'TvChannel', name, 0); }

// Honest "server unreachable" state (replaces the old fake demo titles)
function serverDownHtml() {
  return `<div class="empty" style="grid-column:1/-1;width:100%;">
    <div class="empty-icon">📡</div>
    <h3>Can’t reach the media server</h3>
    <p style="font-size:13px;color:var(--text2);margin-bottom:14px;">Check that the server is on, then try again.</p>
    <button class="upload-btn" onclick="retryConnect()">↻ Retry</button>
  </div>`;
}
function retryConnect() {
  APP.connectAttempted = false;
  renderAll(); // shows skeletons while we retry
  if (APP.currentPage==='movies') document.getElementById('movies-grid').innerHTML = skeletonGrid(12);
  if (APP.currentPage==='tv') document.getElementById('tv-grid').innerHTML = skeletonGrid(12);
  toast('Reconnecting…','info');
  autoConnectJellyfin();
}

// ═══════════════════════════
// ARCADE
// ═══════════════════════════
function selectConsole(el, key) {
  document.querySelectorAll('.console-btn').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
  APP.currentConsole = key;
  renderGamesGrid(key);
}

// Opens the emulator modal (no game loaded yet) — used by Quick Play / Upload
function openEmulator(consoleKey, gameTitle) {
  const _emWasHidden=document.getElementById('emulator-modal').classList.contains('hidden');
  document.getElementById('emulator-modal').classList.remove('hidden');
  if(_emWasHidden) pushHistory({modal:'emulator',page:APP.currentPage});
  const key = consoleKey||APP.currentConsole;
  document.getElementById('emulator-title').textContent = gameTitle||('Arcade — '+CONSOLE_NAMES[key]);
  document.getElementById('emulator-core-select').value = key;
  const f=document.getElementById('ejs-frame'); if(f) f.remove();
  document.getElementById('emulator-placeholder').style.display='flex';
  document.getElementById('emu-ph-title').textContent='Load a ROM to Play';
  document.getElementById('emu-ph-msg').textContent='Pick a console above and upload a ROM, or set your ROM Library URL in Settings to auto-load games.';
  document.getElementById('emu-ph-path').textContent='NES, SNES, N64, Genesis, Dreamcast, PS1, GBA & more';
  APP.emulatorLoaded=false;
}

// Catalog click: open the modal and auto-load the game from the hosted ROM library
function openGame(consoleKey, title){
  openEmulator(consoleKey, title);
  const url=romUrlFor(consoleKey,title);
  if(url){
    launchEmulator(consoleKey, title, url);
  } else {
    // No ROM library configured → show guidance + upload fallback
    document.getElementById('emulator-core-select').value=consoleKey;
    document.getElementById('emu-ph-title').textContent=title;
    document.getElementById('emu-ph-msg').textContent='Set your ROM Library URL in Settings to auto-load games, or upload this game’s ROM now.';
    document.getElementById('emu-ph-path').textContent='Expected file: /'+consoleKey+'/'+romFilename(consoleKey,title);
  }
}

function closeEmulator() {
  document.getElementById('emulator-modal').classList.add('hidden');
  const f=document.getElementById('ejs-frame'); if(f) f.remove(); // fresh globals every launch
  document.getElementById('emulator-placeholder').style.display='flex';
  APP.emulatorLoaded=false;
}

// Launches EmulatorJS inside an isolated iframe so each game gets a clean global scope
// (fixes the black-screen-on-second-launch bug). romUrl can be an http(s) URL or a blob: URL.
function launchEmulator(consoleKey, title, romUrl) {
  const core=EMULATOR_CORES[consoleKey]||'fceumm';
  document.getElementById('emulator-title').textContent=title||('Arcade — '+CONSOLE_NAMES[consoleKey]);
  document.getElementById('emulator-placeholder').style.display='none';
  const container=document.getElementById('emulator-container');
  const old=document.getElementById('ejs-frame'); if(old) old.remove();
  const frame=document.createElement('iframe');
  frame.id='ejs-frame';
  frame.allow='autoplay; fullscreen; gamepad; clipboard-write';
  frame.style.cssText='width:100%;height:100%;border:0;display:block;background:#000;';
  const cfg = {
    EJS_player:'#game', EJS_core:core, EJS_gameUrl:romUrl,
    EJS_pathtodata:'https://cdn.emulatorjs.org/stable/data/',
    EJS_color:'#E50914', EJS_startOnLoaded:true,
    EJS_VirtualGamepad: getSetting('vgamepad', true),
    EJS_Buttons:{playPause:true,restart:true,mute:true,settings:true,fullscreen:true,saveState:true,loadState:true,screenRecord:false,gamepad:getSetting('gamepad',true),cheat:false}
  };
  frame.srcdoc = `<!DOCTYPE html><html><head><meta charset="utf-8">
    <style>html,body{margin:0;width:100%;height:100%;background:#000;overflow:hidden}#game{width:100%;height:100%}</style></head>
    <body><div id="game"></div>
    <script>${Object.entries(cfg).map(([k,v])=>`window.${k}=${JSON.stringify(v)};`).join('')}<\/script>
    <script src="https://cdn.emulatorjs.org/stable/data/loader.js"><\/script>
    </body></html>`;
  container.appendChild(frame);
  APP.emulatorLoaded=true;
  console.log(`[MelloHaven] Launching "${title}" (${core}) from ${romUrl.startsWith('blob:')?'upload':romUrl}`);
}

document.getElementById('rom-file-input').addEventListener('change', function(e) {
  const file=e.target.files[0]; if(!file) return;
  const consoleKey=document.getElementById('emulator-core-select').value||'nes';
  const blobUrl=URL.createObjectURL(file);
  toast(`Loading ${file.name}…`);
  launchEmulator(consoleKey, file.name.replace(/\.[^.]+$/,''), blobUrl);
  this.value='';
});

function toggleFullscreen() {
  const f=document.getElementById('ejs-frame')||document.getElementById('emulator-container');
  if(!document.fullscreenElement) f.requestFullscreen?.(); else document.exitFullscreen?.();
}

// ═══════════════════════════
// REQUESTS
// ═══════════════════════════
async function submitRequest() {
  const title=document.getElementById('req-title').value.trim();
  if(!title){toast('Please enter a title','warn');return;}
  const body={title, type:document.getElementById('req-type').value, priority:document.getElementById('req-priority').value, notes:document.getElementById('req-notes').value.trim()};
  try{
    const r=await fetch(`${API_BASE}/api/requests`,{method:'POST',headers:{'Content-Type':'application/json',...apiHeaders()},body:JSON.stringify(body)});
    const d=await r.json();
    if(!r.ok){ toast(d.error||'Could not submit','error'); return; }
    APP.requests.unshift(d.request);
    document.getElementById('req-title').value=''; document.getElementById('req-notes').value='';
    renderRequestsList(); updateRequestsBadge();
    toast(`Request for "${title}" sent!`);
  }catch{ toast('Can’t reach the server','error'); }
}

// ═══════════════════════════
// JELLYFIN — token comes from the API broker (creds stay server-side)
// ═══════════════════════════
async function autoConnectJellyfin() {
  try {
    console.log('[MelloVibes] Requesting Jellyfin token from API…');
    const r = await fetch(`${API_BASE}/api/jellyfin`, { headers: apiHeaders() });
    if (r.ok) {
      const d = await r.json();
      APP.jellyfinUrl = d.url;
      APP.jellyfinToken = d.token;
      APP.jellyfinUserId = d.userId;
      if (d.deviceId) APP.deviceId = d.deviceId; // keeps presence sessions distinct per person
      console.log('[MelloVibes] Jellyfin connected via broker as device', APP.deviceId);
      checkJellyfinStatus();
      await fetchJellyfinLibrary();
    } else {
      const d = await r.json().catch(()=>({}));
      console.warn('[MelloVibes] Jellyfin broker error:', r.status, d.error);
      checkJellyfinStatus();
      toast(d.error || `Jellyfin unavailable (${r.status})`, 'error');
    }
  } catch(e) {
    console.warn('[MelloVibes] Could not reach API for Jellyfin token:', e);
    checkJellyfinStatus();
  }
  APP.connectAttempted = true;
  if (!APP.libraryLoaded) { // connection failed → honest server-down state
    renderAll();
    if (APP.currentPage==='movies') document.getElementById('movies-grid').innerHTML=serverDownHtml();
    if (APP.currentPage==='tv') document.getElementById('tv-grid').innerHTML=serverDownHtml();
  }
}

function checkJellyfinStatus() {
  const el=document.getElementById('jellyfin-connection-status'); if(!el) return;
  if(APP.jellyfinToken&&APP.jellyfinUrl){el.className='nf-status ok';el.innerHTML=`<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> Connected to ${APP.jellyfinUrl}`;}
  else{el.className='nf-status warn';el.innerHTML=`⚠ Not connected — click Reconnect`;}
}

async function refreshLibrary(){toast('Refreshing library…');await fetchJellyfinLibrary();}

async function fetchJellyfinLibrary() {
  if(!APP.jellyfinToken||!APP.jellyfinUserId||!APP.jellyfinUrl){ console.warn('[MelloHaven] fetchLibrary: missing token/userId/url'); return false; }
  const headers={'Authorization':`MediaBrowser Token="${APP.jellyfinToken}"`};
  const base=`${APP.jellyfinUrl}/Users/${APP.jellyfinUserId}/Items`;
  const fields='Overview,Genres,CommunityRating,ProductionYear,UserData,RemoteTrailers,Studios';
  try{
    const [mResp, sResp, rResp] = await Promise.all([
      fetch(`${base}?IncludeItemTypes=Movie&Recursive=true&SortBy=DateCreated&SortOrder=Descending&Fields=${fields}&Limit=1000`,{headers}),
      fetch(`${base}?IncludeItemTypes=Series&Recursive=true&SortBy=DateCreated&SortOrder=Descending&Fields=${fields}&Limit=1000`,{headers}),
      fetch(`${APP.jellyfinUrl}/Users/${APP.jellyfinUserId}/Items/Resume?MediaTypes=Video&Limit=12&Fields=${fields}`,{headers})
    ]);
    // Stale/expired token → signal caller to re-authenticate
    if(mResp.status===401||mResp.status===403){ console.warn('[MelloHaven] Library fetch unauthorized (token stale)'); return false; }
    if(mResp.ok){const d=await mResp.json();APP.jfMovies=d.Items||[];}
    if(sResp.ok){const d=await sResp.json();APP.jfShows=d.Items||[];}
    if(rResp.ok){const d=await rResp.json();APP.jfResume=d.Items||[];}
    console.log(`[MelloHaven] Library loaded: ${APP.jfMovies.length} movies, ${APP.jfShows.length} shows, ${APP.jfResume.length} resume`);
    APP.libraryLoaded = true;
    buildFeatured();
    renderAll();
    refreshFavorites(); // populate My List row
    startPresence();    // begin polling who's watching
    renderTop10(); renderCollections(); renderRecommended(); renderNextUp(); renderHomeLiveTV(); // enhanced home rows
    if(APP.featuredItems.length) initBillboard(); // swap hero to real titles
    if(APP.currentPage==='movies') renderJellyfinGrid('movies-grid',APP.jfMovies);
    if(APP.currentPage==='tv') renderJellyfinGrid('tv-grid',APP.jfShows);
    if(APP.jfMovies.length||APP.jfShows.length){ toast(`Loaded ${APP.jfMovies.length} movies + ${APP.jfShows.length} shows from Jellyfin`); return true; }
    console.warn('[MelloHaven] Connected but library is empty');
    return false;
  } catch(e){ console.warn('[MelloHaven] Jellyfin fetch error:',e); return false; }
}

function jfPlayUrl(id){return `${APP.jellyfinUrl}/web/index.html#!/details?id=${id}`;}

// ═══════════════════════════
// PLAYBACK REPORTING (keeps Continue Watching + resume points in sync)
// ═══════════════════════════
function jfReport(endpoint, body){
  if(!APP.jellyfinToken||!APP.jellyfinUrl) return;
  fetch(`${APP.jellyfinUrl}/Sessions/Playing${endpoint}`,{
    method:'POST',
    headers:{'Content-Type':'application/json','Authorization':jfAuthHeader()},
    body:JSON.stringify(body)
  }).catch(()=>{});
}

function startPlaybackReporting(itemId, psid){
  stopPlaybackReporting(true);
  const videoEl=document.getElementById('main-video-player');
  const ticks=()=>Math.floor((videoEl.currentTime||0)*1e7);
  jfReport('',{ItemId:itemId,PlaySessionId:psid,PositionTicks:ticks(),CanSeek:true,IsPaused:false});
  const onPause=()=>jfReport('/Progress',{ItemId:itemId,PlaySessionId:psid,PositionTicks:ticks(),IsPaused:true,EventName:'Pause'});
  const onPlay =()=>jfReport('/Progress',{ItemId:itemId,PlaySessionId:psid,PositionTicks:ticks(),IsPaused:false,EventName:'Unpause'});
  videoEl.addEventListener('pause',onPause);
  videoEl.addEventListener('play',onPlay);
  const timer=setInterval(()=>{ if(!videoEl.paused) jfReport('/Progress',{ItemId:itemId,PlaySessionId:psid,PositionTicks:ticks(),IsPaused:false,EventName:'TimeUpdate'}); },10000);
  APP.playSession={itemId,psid,timer,onPause,onPlay};
}

function stopPlaybackReporting(silent){
  const s=APP.playSession; if(!s) return;
  const videoEl=document.getElementById('main-video-player');
  if(s.timer) clearInterval(s.timer);
  if(s.onPause) videoEl.removeEventListener('pause',s.onPause);
  if(s.onPlay) videoEl.removeEventListener('play',s.onPlay);
  jfReport('/Stopped',{ItemId:s.itemId,PlaySessionId:s.psid,PositionTicks:Math.floor((videoEl.currentTime||0)*1e7)});
  APP.playSession=null;
  if(!silent) setTimeout(refreshResume,1500); // let Jellyfin process, then update Continue Watching
}

async function refreshResume(){
  if(!APP.jellyfinToken||!APP.jellyfinUrl) return;
  try{
    const headers={'Authorization':`MediaBrowser Token="${APP.jellyfinToken}"`};
    const r=await fetch(`${APP.jellyfinUrl}/Users/${APP.jellyfinUserId}/Items/Resume?MediaTypes=Video&Limit=12&Fields=Overview,Genres,CommunityRating,ProductionYear,UserData`,{headers});
    if(r.ok){const d=await r.json();APP.jfResume=d.Items||[];renderAll();}
  }catch{}
  renderNextUp();
}

// "Next Up" — the next unwatched episode of each show you're into (Jellyfin native)
async function renderNextUp(){
  const row=document.getElementById('home-nextup-row'); const sc=document.getElementById('home-nextup-scroll');
  if(!row||!APP.jellyfinToken) return;
  try{
    const r=await fetch(`${APP.jellyfinUrl}/Shows/NextUp?UserId=${APP.jellyfinUserId}&Limit=12&Fields=Overview,UserData`,{headers:jfHeaders()});
    if(!r.ok){ row.style.display='none'; return; }
    const eps=(await r.json()).Items||[];
    if(!eps.length){ row.style.display='none'; return; }
    sc.innerHTML=eps.map(ep=>{
      const label=`S${ep.ParentIndexNumber||'?'}:E${ep.IndexNumber||'?'}`;
      const resume=ep.UserData?.PlaybackPositionTicks||0;
      const safe=(ep.Name||'').replace(/'/g,"\\'");
      return `<div class="nw-card" style="cursor:pointer;" onclick="openJellyfinItem('${ep.Id}','Episode','${safe}',${resume})">
        <img class="nw-thumb" src="${APP.jellyfinUrl}/Items/${ep.Id}/Images/Primary?api_key=${APP.jellyfinToken}&maxWidth=400&quality=80" loading="lazy" onerror="this.style.display='none'">
        <div class="nw-overlay">
          <div class="nw-who">${escHtml(ep.SeriesName||'')}</div>
          <div class="nw-title">${label} · ${escHtml(ep.Name||'')}</div>
        </div>
      </div>`;
    }).join('');
    row.style.display='';
  }catch{ row.style.display='none'; }
}

// Remove an item from Continue Watching (marks it played in Jellyfin)
async function removeFromContinue(itemId, btn){
  if(btn){ const card=btn.closest('.nf-card'); if(card){ card.style.transition='opacity .2s'; card.style.opacity='0.3'; } }
  try{
    await fetch(`${APP.jellyfinUrl}/Users/${APP.jellyfinUserId}/PlayedItems/${itemId}`,{method:'POST',headers:jfHeaders()});
    APP.jfResume = APP.jfResume.filter(i=>i.Id!==itemId);
    renderAll();
    toast('Removed from Continue Watching','info');
  }catch{ toast('Could not remove','error'); if(btn){const card=btn.closest('.nf-card'); if(card) card.style.opacity='1';} }
}

// ═══════════════════════════
// DETAIL MODAL + FAVORITES + WATCHED
// ═══════════════════════════
function jfHeaders(){ return {'Authorization':`MediaBrowser Token="${APP.jellyfinToken}"`}; }

async function openDetail(itemId, wantTab){
  APP._wantDetailTab = wantTab || null;
  const modal=document.getElementById('detail-modal');
  const _dWasHidden=modal.classList.contains('hidden');
  modal.classList.remove('hidden');
  if(_dWasHidden) pushHistory({modal:'detail',page:APP.currentPage});
  document.getElementById('detail-title').textContent='Loading…';
  document.getElementById('detail-meta').innerHTML='';
  document.getElementById('detail-overview').textContent='';
  document.getElementById('detail-extra').innerHTML='';
  const bd=document.getElementById('detail-backdrop'); bd.classList.remove('show'); bd.removeAttribute('src');
  if(!APP.jellyfinToken){ document.getElementById('detail-title').textContent='Connect Jellyfin in Settings to see details'; return; }
  try{
    const r=await fetch(`${APP.jellyfinUrl}/Users/${APP.jellyfinUserId}/Items/${itemId}?Fields=Overview,Genres,People,MediaStreams,MediaSources,RunTimeTicks`,{headers:jfHeaders()});
    const item=await r.json();
    APP.detailItem=item;
    renderDetail(item);
  }catch(e){ document.getElementById('detail-title').textContent='Could not load details'; }
}

function renderDetail(item){
  const isSeries=item.Type==='Series';
  document.getElementById('detail-title').textContent=item.Name;
  const tag=item.BackdropImageTags&&item.BackdropImageTags.length;
  const bd=document.getElementById('detail-backdrop');
  bd.onload=()=>bd.classList.add('show');
  bd.src=tag
    ? `${APP.jellyfinUrl}/Items/${item.Id}/Images/Backdrop/0?api_key=${APP.jellyfinToken}&maxWidth=1280&quality=90`
    : `${APP.jellyfinUrl}/Items/${item.Id}/Images/Primary?api_key=${APP.jellyfinToken}&maxWidth=1280&quality=90`;
  const runtime=item.RunTimeTicks?Math.round(item.RunTimeTicks/600000000)+' min':'';
  const ud=item.UserData||{};
  const meta=[];
  if(ud.PlayedPercentage>0&&ud.PlayedPercentage<100) meta.push(`<span class="dm-match">${Math.round(ud.PlayedPercentage)}% watched</span>`);
  if(item.CommunityRating) meta.push(`<span class="dm-match">⭐ ${item.CommunityRating.toFixed(1)}</span>`);
  if(item.ProductionYear) meta.push(`<span class="dm-tag">${item.ProductionYear}</span>`);
  if(runtime) meta.push(`<span class="dm-tag">${runtime}</span>`);
  if(item.OfficialRating) meta.push(`<span class="dm-box">${item.OfficialRating}</span>`);
  (item.Genres||[]).slice(0,3).forEach(g=>meta.push(`<span class="dm-box">${escHtml(g)}</span>`));
  document.getElementById('detail-meta').innerHTML=meta.join('');
  document.getElementById('detail-overview').textContent=item.Overview||'No description available.';
  const cast=(item.People||[]).filter(p=>p.Type==='Actor').slice(0,5).map(p=>escHtml(p.Name));
  const dir=(item.People||[]).filter(p=>p.Type==='Director').slice(0,2).map(p=>escHtml(p.Name));
  let extra='';
  if(cast.length) extra+=`<div class="dx-row"><span class="dx-label">Cast:</span> ${cast.join(', ')}</div>`;
  if(dir.length) extra+=`<div class="dx-row"><span class="dx-label">Director:</span> ${dir.join(', ')}</div>`;
  if(isSeries) extra+=`<div class="dx-row" style="margin-top:6px;color:var(--text3);">Press Play to browse seasons & episodes.</div>`;
  document.getElementById('detail-extra').innerHTML=extra;
  const resume=ud.PlaybackPositionTicks||0;
  const playBtn=document.getElementById('detail-play');
  playBtn.innerHTML=`<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg> ${resume>0?'Resume':'Play'}`;
  playBtn.onclick=()=>{ closeDetail(); if(isSeries) openEpisodePicker(item.Id,item.Name); else openJellyfinItem(item.Id,item.Type,item.Name,resume); };
  const favBtn=document.getElementById('detail-fav');
  favBtn.classList.toggle('active', !!ud.IsFavorite); favBtn.textContent=ud.IsFavorite?'✓':'+';
  favBtn.onclick=()=>toggleFavorite(item.Id, favBtn);
  const wBtn=document.getElementById('detail-watched');
  wBtn.classList.toggle('active', !!ud.Played);
  wBtn.onclick=()=>toggleWatched(item.Id, wBtn);
  const dlBtn=document.getElementById('detail-download');
  dlBtn.style.display = isSeries ? 'none' : '';   // whole-series download isn't a thing; movies/episodes only
  dlBtn.onclick=()=>downloadItem(item.Id, item.Name);
  const trBtn=document.getElementById('detail-trailer');
  const ytId=trailerIdFor(item);
  trBtn.style.display=ytId?'':'none';
  trBtn.onclick=()=>openTrailer(ytId);
  enrichDetail(item); // tabs: episodes, similar, cast, details
}

function closeDetail(){ document.getElementById('detail-modal').classList.add('hidden'); }

async function toggleFavorite(itemId, btn){
  if(!APP.jellyfinToken){ toast('Connect Jellyfin first'); return; }
  const isActive=btn.classList.contains('active');
  try{
    await fetch(`${APP.jellyfinUrl}/Users/${APP.jellyfinUserId}/FavoriteItems/${itemId}`,{method:isActive?'DELETE':'POST',headers:jfHeaders()});
    btn.classList.toggle('active');
    if(btn.id==='detail-fav') btn.textContent=isActive?'+':'✓';
    toast(isActive?'Removed from My List':'Added to My List ✓');
    refreshFavorites();
  }catch{ toast('Could not update My List','error'); }
}

async function toggleWatched(itemId, btn){
  if(!APP.jellyfinToken){ toast('Connect Jellyfin first'); return; }
  const isActive=btn.classList.contains('active');
  try{
    await fetch(`${APP.jellyfinUrl}/Users/${APP.jellyfinUserId}/PlayedItems/${itemId}`,{method:isActive?'DELETE':'POST',headers:jfHeaders()});
    btn.classList.toggle('active');
    toast(isActive?'Marked unwatched':'Marked watched ✓');
    refreshResume();
  }catch{ toast('Could not update','error'); }
}

// Download the original file for offline viewing (plays in any device video player)
function downloadItem(id, name){
  if(!APP.jellyfinToken){ toast('Not connected to the server','error'); return; }
  const url=`${APP.jellyfinUrl}/Items/${id}/Download?api_key=${APP.jellyfinToken}`;
  const a=document.createElement('a');
  a.href=url; a.download=(name||'video'); a.rel='noopener';
  document.body.appendChild(a); a.click(); a.remove();
  toast('Download started — saving the original file to your device','info');
}

async function refreshFavorites(){
  if(!APP.jellyfinToken) return;
  try{
    const r=await fetch(`${APP.jellyfinUrl}/Users/${APP.jellyfinUserId}/Items?Filters=IsFavorite&Recursive=true&IncludeItemTypes=Movie,Series&Fields=Overview,Genres,CommunityRating,ProductionYear,UserData&Limit=30`,{headers:jfHeaders()});
    if(r.ok){const d=await r.json();APP.jfFavorites=d.Items||[];renderAll();}
  }catch{}
}

// ═══════════════════════════
// NOW WATCHING (live presence via Jellyfin /Sessions)
// ═══════════════════════════
let nwTimer=null;
function startPresence(){ if(nwTimer) return; pollSessions(); nwTimer=setInterval(pollSessions, 20000); }
function stopPresence(){ if(nwTimer) clearInterval(nwTimer); nwTimer=null; const r=document.getElementById('home-nowwatching-row'); if(r) r.style.display='none'; }

async function pollSessions(){
  if(!APP.jellyfinToken||!APP.jellyfinUrl) return;
  try{
    const r=await fetch(`${API_BASE}/api/sessions`,{headers:apiHeaders()});
    if(!r.ok) return;
    const d=await r.json();
    const active=(d.sessions||[]).filter(s=>s.NowPlayingItem && s.DeviceId!==APP.deviceId);
    renderNowWatching(active);
  }catch{}
}

function renderNowWatching(sessions){
  const row=document.getElementById('home-nowwatching-row');
  const scroll=document.getElementById('home-nowwatching-scroll');
  if(!sessions.length){ row.style.display='none'; return; }
  scroll.innerHTML=sessions.map(s=>{
    const it=s.NowPlayingItem;
    const who=s.DeviceName||s.UserName||'Someone';
    const img=`${APP.jellyfinUrl}/Items/${it.Id}/Images/Primary?api_key=${APP.jellyfinToken}&maxWidth=400&quality=80`;
    const title= it.SeriesName ? `${it.SeriesName} — ${it.Name}` : it.Name;
    const pct=(s.PlayState && it.RunTimeTicks) ? Math.min(100,(s.PlayState.PositionTicks/it.RunTimeTicks)*100) : 0;
    const paused=s.PlayState && s.PlayState.IsPaused;
    return `<div class="nw-card">
      <img class="nw-thumb" src="${img}" onerror="this.style.display='none'">
      <div class="nw-overlay">
        <div class="nw-who"><span class="nw-avatar">${escHtml(who[0].toUpperCase())}</span><span class="nw-dot" style="${paused?'background:#f59e0b;box-shadow:none;animation:none;':''}"></span>${escHtml(who)} · ${paused?'paused':'watching'}</div>
        <div class="nw-title">${escHtml(title)}</div>
      </div>
      <div class="nw-prog"><div class="nw-prog-fill" style="width:${pct}%"></div></div>
    </div>`;
  }).join('');
  row.style.display='';
}

// Full MediaBrowser auth header (token + client identity) so Jellyfin registers a play session
function jfAuthHeader(){
  const devName=(APP.currentUser&&APP.currentUser.name)||'Browser';
  return `MediaBrowser Client="MelloVibes", Device="${devName.replace(/"/g,'')}", DeviceId="${APP.deviceId}", Version="1.0.0", Token="${APP.jellyfinToken}"`;
}

// Detect what THIS browser can actually decode, so Jellyfin only transcodes when truly needed
function detectVideoCodecs(){
  const v=document.createElement('video');
  const map={
    h264:'video/mp4; codecs="avc1.42E01E"',
    hevc:'video/mp4; codecs="hvc1.1.6.L93.B0"',
    vp9 :'video/webm; codecs="vp9"',
    av1 :'video/mp4; codecs="av01.0.05M.08"'
  };
  return Object.keys(map).filter(c=>v.canPlayType(map[c])!=='');
}
function detectAudioCodecs(){
  const a=document.createElement('audio');
  const map={
    aac:'audio/mp4; codecs="mp4a.40.2"',
    mp3:'audio/mpeg',
    opus:'audio/webm; codecs="opus"',
    flac:'audio/mp4; codecs="flac"',
    ac3:'audio/mp4; codecs="ac-3"',
    eac3:'audio/mp4; codecs="ec-3"'
  };
  return Object.keys(map).filter(c=>a.canPlayType(map[c])!=='');
}

// Browser device profile for PlaybackInfo negotiation
function buildDeviceProfile(){
  const vcodecs=detectVideoCodecs();
  const acodecs=detectAudioCodecs();
  const vList=(vcodecs.length?vcodecs:['h264']).join(',');
  const aList=(acodecs.length?acodecs:['aac','mp3']).join(',');
  return {
    MaxStreamingBitrate:20000000, MaxStaticBitrate:20000000, MusicStreamingTranscodingBitrate:384000,
    DirectPlayProfiles:[
      {Container:'mp4,m4v,mov', Type:'Video', VideoCodec:vList, AudioCodec:aList},
      {Container:'webm', Type:'Video', VideoCodec:'vp8,vp9,av1', AudioCodec:'vorbis,opus'},
      {Container:'mp3', Type:'Audio'}, {Container:'aac', Type:'Audio'}, {Container:'flac', Type:'Audio'}
    ],
    TranscodingProfiles:[
      {Container:'ts', Type:'Video', Protocol:'hls', VideoCodec:'h264', AudioCodec:'aac,mp3', Context:'Streaming', MaxAudioChannels:'2', MinSegments:1, BreakOnNonKeyFrames:true},
      {Container:'aac', Type:'Audio', AudioCodec:'aac', Protocol:'http', Context:'Streaming', MaxAudioChannels:'2'}
    ],
    ContainerProfiles:[], CodecProfiles:[],
    SubtitleProfiles:[
      {Format:'vtt', Method:'External'}, {Format:'subrip', Method:'Embed'},
      {Format:'ass', Method:'Encode'}, {Format:'ssa', Method:'Encode'}, {Format:'pgssub', Method:'Encode'}
    ]
  };
}

function showStreamError(itemId, type, title, reason, detail){
  const videoEl=document.getElementById('main-video-player');
  const promptEl=document.getElementById('video-prompt');
  videoEl.style.display='none'; document.getElementById('subtitle-bar').style.display='none'; promptEl.style.display='flex';
  promptEl.innerHTML=`<div style="text-align:center;padding:32px;max-width:460px;">
    <div style="font-size:44px;margin-bottom:12px;">⚠️</div>
    <div style="font-size:16px;font-weight:700;margin-bottom:8px;">${escHtml(reason)}</div>
    <p style="font-size:13px;color:var(--text2);margin-bottom:8px;">${escHtml(detail||'')}</p>
    <p style="font-size:11px;color:var(--text3);margin-bottom:18px;">${escHtml(title)} · ${escHtml(itemId)}</p>
    <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
      <button class="upload-btn" onclick="openJellyfinItem('${itemId}','${type}','${escHtml(title)}')">↻ Retry</button>
      <button class="nf-btn-ghost" style="width:auto;padding:11px 18px;" onclick="openInJellyfin()">Open in Jellyfin ↗</button>
    </div>
  </div>`;
}

async function openJellyfinItem(itemId,type,title,resumeTicks,opts){
  opts = opts || {};
  APP.currentItemId=itemId;
  document.getElementById('video-modal-title').textContent=title;
  const _pt=document.getElementById('pui-title'); if(_pt) _pt.textContent=title;
  const _pui=document.getElementById('player-ui'); if(_pui) _pui.style.display='none';
  const _vmWasHidden=document.getElementById('video-modal').classList.contains('hidden');
  document.getElementById('video-modal').classList.remove('hidden');
  if(_vmWasHidden) pushHistory({modal:'video',page:APP.currentPage});
  const videoEl=document.getElementById('main-video-player');
  const promptEl=document.getElementById('video-prompt');
  const subtitleBar=document.getElementById('subtitle-bar');
  promptEl.style.display='flex'; promptEl.innerHTML=`<div class="spin"></div><span style="color:var(--text2);font-size:13px;">Loading ${escHtml(title)}…</span>`;
  videoEl.style.display='none'; subtitleBar.style.display='none';
  cancelUpNext();
  if(APP.hlsInstance){APP.hlsInstance.destroy();APP.hlsInstance=null;}

  const base=APP.jellyfinUrl, token=APP.jellyfinToken, userId=APP.jellyfinUserId;
  if(!token||!base){ showStreamError(itemId,type,title,'Not connected to Jellyfin','Open Settings and reconnect your server.'); return; }

  // ── 1. Ask Jellyfin how to play this item (Direct Play / Direct Stream / Transcode) ──
  let info;
  try{
    const r=await fetch(`${base}/Items/${itemId}/PlaybackInfo?UserId=${userId}`,{
      method:'POST',
      headers:{'Content-Type':'application/json','Authorization':jfAuthHeader()},
      body:JSON.stringify({
        DeviceProfile:buildDeviceProfile(),
        UserId:userId, MaxStreamingBitrate:20000000,
        StartTimeTicks:resumeTicks||0,
        ...(opts.audioStreamIndex!=null?{AudioStreamIndex:opts.audioStreamIndex}:{}),
        EnableDirectPlay:true, EnableDirectStream:true, EnableTranscoding:true,
        AllowVideoStreamCopy:true, AllowAudioStreamCopy:true, AutoOpenLiveStream:true
      })
    });
    if(r.status===401||r.status===403){ showStreamError(itemId,type,title,'Authentication failed','Your Jellyfin token was rejected. Reconnect in Settings.'); return; }
    if(!r.ok){ showStreamError(itemId,type,title,`PlaybackInfo error (${r.status})`,'The server rejected the playback request. If the library loads but this fails, check CORS rules on the /Items endpoint.'); return; }
    info=await r.json();
  }catch(e){
    console.warn('[MelloHaven] PlaybackInfo failed',e);
    showStreamError(itemId,type,title,'Could not reach the server','The streaming request was blocked (likely CORS) or the connection dropped. Add this site to Jellyfin → Dashboard → Networking → CORS hosts.');
    return;
  }

  const source=(info.MediaSources||[])[0];
  if(!source){ showStreamError(itemId,type,title,'No playable source','Jellyfin returned no media source for this item.'); return; }
  const psid=info.PlaySessionId||Date.now().toString();

  // Remember what's playing (for audio switch / next-episode) and build the track bar
  APP.nowPlaying={itemId,type,title};
  populateTrackBar(source, itemId, psid, opts.audioStreamIndex);
  loadNextEpisode(itemId); // preload "Up Next" if this is an episode
  loadIntro(itemId); // best-effort Skip Intro
  videoEl.ontimeupdate = checkIntro;

  let _started=false;
  function onPlaying(){
    promptEl.style.display='none'; videoEl.style.display='block';
    const ui=document.getElementById('player-ui'); if(ui){ ui.style.display='block'; if(window.puiShow) puiShow(); }
    if(!_started){ _started=true; startPlaybackReporting(itemId,psid); }
  }
  videoEl.onloadeddata=onPlaying;

  // Resume from saved position on Direct Play/Stream (seek once metadata is ready).
  // For transcode, StartTimeTicks handles the offset server-side.
  if(resumeTicks>0){
    videoEl.addEventListener('loadedmetadata',function(){ try{ if(videoEl.currentTime<1) videoEl.currentTime=resumeTicks/1e7; }catch(e){} },{once:true});
  }

  const tail=`${resumeTicks>0?`&StartTimeTicks=${resumeTicks}`:''}${opts.audioStreamIndex!=null?`&AudioStreamIndex=${opts.audioStreamIndex}`:''}`;
  const segBase=`${base}/Videos/${itemId}/master.m3u8?api_key=${token}&MediaSourceId=${source.Id}&AudioCodec=aac,mp3&TranscodingMaxAudioChannels=2&SegmentContainer=ts&MinSegments=1&BreakOnNonKeyFrames=true&PlaySessionId=${psid}`;
  // REMUX: copy original video untouched (no re-encode). Best quality, needs full bandwidth.
  const remuxUrl=`${segBase}&VideoCodec=copy${tail}`;
  // Quality-capped TRANSCODE: re-encodes smaller to fit limited bandwidth (fixes buffering).
  const QMAP={'1080':[1920,8000000],'720':[1280,3000000],'480':[854,1200000]};
  function transcodeUrlFor(q){ const [mw,vb]=QMAP[q]||QMAP['720']; return `${segBase}&VideoCodec=h264&VideoBitrate=${vb}&AudioBitrate=192000&MaxWidth=${mw}${tail}`; }
  const forcedTranscodeUrl=transcodeUrlFor('1080'); // last-resort full transcode
  // Fast path → slow path: remux first, full transcode only if that fails.
  function remuxThenTranscode(){ playHls(remuxUrl,'Remux (copy video)',()=>playHls(forcedTranscodeUrl,'Transcode (full)',null)); }

  // ── Plays an HLS stream; on fatal error runs the provided fallback (or shows error) ──
  function playHls(hlsUrl, label, onFail){
    if(typeof Hls==='undefined' || !Hls.isSupported()){
      if(videoEl.canPlayType('application/vnd.apple.mpegurl')){ // Safari native HLS
        videoEl.src=hlsUrl; videoEl.style.display='block'; videoEl.play().catch(()=>{});
        videoEl.onerror=()=> onFail ? onFail() : showStreamError(itemId,type,title,'Playback failed','Native HLS could not load the stream.');
        return;
      }
      return onFail ? onFail() : showStreamError(itemId,type,title,'HLS unsupported','This browser cannot play HLS.');
    }
    const hls=new Hls({maxBufferLength:60,maxMaxBufferLength:180,maxBufferSize:80*1000*1000,enableWorker:true,xhrSetup:(xhr)=>{xhr.withCredentials=false;}});
    APP.hlsInstance=hls;
    hls.loadSource(hlsUrl); hls.attachMedia(videoEl);
    hls.on(Hls.Events.MANIFEST_PARSED,()=>{ console.log(`[MelloHaven] Playing "${title}" via ${label}`); onPlaying(); videoEl.play().catch(()=>{}); });
    hls.on(Hls.Events.ERROR,(evt,data)=>{
      if(!data.fatal) return;
      hls.destroy(); APP.hlsInstance=null;
      const status=data.response?.code;
      console.warn(`[MelloHaven] ${label} failed`,data);
      if(onFail){ onFail(status); return; }
      let detail=`${data.type||''} · ${data.details||''}`;
      if(status===404) detail='Jellyfin could not start a transcode (404). Make sure ffmpeg is installed and the transcode folder is writable.';
      else if(status===500||status===503) detail='ffmpeg crashed while transcoding (500/503). Check Jellyfin → Dashboard → Logs for the transcode error.';
      else if(!status) detail='Transcode segments were blocked or timed out.';
      showStreamError(itemId,type,title,'Transcoding failed on the server',detail);
    });
  }

  // ── Plays a direct (static) file in the <video> tag; on error falls back to transcode ──
  function playDirect(label){
    const container=(source.Container||'mp4').split(',')[0];
    const directUrl=`${base}/Videos/${itemId}/stream.${container}?static=true&mediaSourceId=${source.Id}&api_key=${token}&PlaySessionId=${psid}`;
    videoEl.src=directUrl; videoEl.style.display='block';
    videoEl.play().then(()=>console.log(`[MelloHaven] Playing "${title}" via ${label}`)).catch(()=>{});
    videoEl.onerror=()=>{
      console.warn(`[MelloHaven] ${label} failed — trying fast remux`);
      videoEl.onerror=null; videoEl.removeAttribute('src'); videoEl.load();
      promptEl.style.display='flex'; promptEl.innerHTML=`<div class="spin"></div><span style="color:var(--text2);font-size:13px;">Preparing ${escHtml(title)}…</span>`;
      remuxThenTranscode();
    };
  }

  // ── Decide first attempt based on chosen quality ──
  const q = APP.quality || '720';
  const qsel = document.getElementById('quality-select'); if(qsel) qsel.value = q;
  if (q !== 'original') {
    // Capped-bitrate transcode to fit the connection (prevents buffering). Falls back to remux.
    promptEl.style.display='flex';
    promptEl.innerHTML=`<div class="spin"></div><span style="color:var(--text2);font-size:13px;">Preparing ${escHtml(title)} (${q}p)…</span>`;
    playHls(transcodeUrlFor(q), `Transcode ${q}p`, ()=>remuxThenTranscode());
  } else if(source.SupportsDirectPlay){
    promptEl.style.display='none';
    playDirect('Direct Play');
  } else {
    promptEl.style.display='flex';
    promptEl.innerHTML=`<div class="spin"></div><span style="color:var(--text2);font-size:13px;">Preparing ${escHtml(title)}…</span>`;
    remuxThenTranscode();
  }
}

// Switch streaming quality mid-playback (re-opens at the current position)
function changeQuality(q){
  APP.quality = q;
  localStorage.setItem('mv_quality', q);
  const np = APP.nowPlaying; if(!np) return;
  const v = document.getElementById('main-video-player');
  const pos = Math.floor((v.currentTime||0)*1e7);
  toast(q==='original' ? 'Switching to original quality…' : `Switching to ${q}p…`);
  openJellyfinItem(np.itemId, np.type, np.title, pos);
}

// ═══════════════════════════
// EPISODE PICKER
// ═══════════════════════════
// Series episodes now live in the detail modal's Episodes tab (single UI)
function openEpisodePicker(seriesId, seriesName) { openDetail(seriesId, 'episodes'); }

function escHtml(s){return s.replace(/['"&<>]/g,c=>({'\'':'\\\'','"':'&quot;','&':'&amp;','<':'&lt;','>':'&gt;'}[c]));}
function openInJellyfin(){if(APP.currentItemId)window.open(jfPlayUrl(APP.currentItemId),'_blank');}
function onVideoEnded(){
  stopPlaybackReporting();
  if(APP.nextEpisode) showUpNext(APP.nextEpisode);
  else toast('Finished playing!');
}

// ── Next-episode "Up Next" ──
function updateNextButton(){
  const b=document.getElementById('vm-next-btn'); if(b) b.style.display = APP.nextEpisode ? '' : 'none';
}
async function loadNextEpisode(itemId){
  APP.nextEpisode=null; updateNextButton();
  if(!APP.jellyfinToken) return;
  try{
    const r=await fetch(`${APP.jellyfinUrl}/Users/${APP.jellyfinUserId}/Items/${itemId}?Fields=SeriesId,IndexNumber,ParentIndexNumber`,{headers:jfHeaders()});
    const it=await r.json();
    if(it.Type!=='Episode'||!it.SeriesId) return;
    const er=await fetch(`${APP.jellyfinUrl}/Shows/${it.SeriesId}/Episodes?UserId=${APP.jellyfinUserId}&Fields=Overview,IndexNumber,ParentIndexNumber`,{headers:jfHeaders()});
    const ed=await er.json();
    const eps=ed.Items||[];
    const idx=eps.findIndex(e=>e.Id===itemId);
    if(idx>=0 && idx+1<eps.length) APP.nextEpisode=eps[idx+1];
    updateNextButton();
  }catch{}
}

function showUpNext(ep){
  const el=document.getElementById('up-next');
  const thumb=`${APP.jellyfinUrl}/Items/${ep.Id}/Images/Primary?api_key=${APP.jellyfinToken}&maxWidth=200&quality=80`;
  const label=`S${ep.ParentIndexNumber||'?'}:E${ep.IndexNumber||'?'}`;
  let countdown=10;
  el.classList.remove('hidden');
  const render=()=>{ el.innerHTML=`
    <img class="up-next-thumb" src="${thumb}" onerror="this.style.display='none'">
    <div class="up-next-info">
      <div class="up-next-label">Up Next · ${label}</div>
      <div class="up-next-title">${escHtml(ep.Name)}</div>
      <div class="up-next-actions">
        <button class="up-next-btn play" onclick="playNextNow()">▶ Play (${countdown})</button>
        <button class="up-next-btn cancel" onclick="cancelUpNext()">Dismiss</button>
      </div>
    </div>`; };
  render();
  clearInterval(APP._upNextTimer);
  APP._upNextTimer=setInterval(()=>{ countdown--; if(countdown<=0) playNextNow(); else render(); },1000);
}
function playNextNow(){ const ep=APP.nextEpisode; cancelUpNext(); if(ep) openJellyfinItem(ep.Id,'Episode',ep.Name,0); }
function cancelUpNext(){ clearInterval(APP._upNextTimer); APP._upNextTimer=null; document.getElementById('up-next').classList.add('hidden'); }
// ── Subtitle / audio track bar ──
function populateTrackBar(source, itemId, psid, currentAudioIdx){
  const bar=document.getElementById('subtitle-bar');
  const subSel=document.getElementById('subtitle-select');
  const audSel=document.getElementById('audio-select');
  const streams=source.MediaStreams||[];
  const subs=streams.filter(s=>s.Type==='Subtitle');
  const auds=streams.filter(s=>s.Type==='Audio');
  APP.curPlay={itemId,psid,sourceId:source.Id,subs,auds};
  subSel.innerHTML='<option value="-1">Off</option>'+subs.map(s=>`<option value="${s.Index}">${escHtml(s.DisplayTitle||s.Language||('Track '+s.Index))}</option>`).join('');
  audSel.innerHTML=auds.map(s=>`<option value="${s.Index}"${ (currentAudioIdx!=null? s.Index===currentAudioIdx : s.IsDefault)?' selected':''}>${escHtml(s.DisplayTitle||s.Language||('Track '+s.Index))}</option>`).join('');
  // Hide the audio control if there's only one track; hide subs control if none
  audSel.parentElement && (audSel.previousElementSibling.style.display = auds.length>1?'':'none', audSel.style.display = auds.length>1?'':'none');
  const qsel=document.getElementById('quality-select'); if(qsel) qsel.value=APP.quality||'720';
  // popover visibility is controlled by the ⚙ button
}

// Load a subtitle as an external VTT track (works for Direct Play AND transcode; no re-encode)
async function changeSubtitle(idx){
  const v=document.getElementById('main-video-player');
  Array.from(v.querySelectorAll('track')).forEach(t=>t.remove());
  Array.from(v.textTracks||[]).forEach(t=>t.mode='disabled');
  idx=parseInt(idx);
  if(idx<0){ return; }
  const cp=APP.curPlay; if(!cp) return;
  const sub=(cp.subs||[]).find(s=>s.Index===idx);
  try{
    const url=`${APP.jellyfinUrl}/Videos/${cp.itemId}/${cp.sourceId}/Subtitles/${idx}/0/Stream.vtt?api_key=${APP.jellyfinToken}`;
    const resp=await fetch(url,{headers:jfHeaders()});
    if(!resp.ok) throw new Error('sub fetch failed');
    const vtt=await resp.text();
    const blobUrl=URL.createObjectURL(new Blob([vtt],{type:'text/vtt'}));
    const track=document.createElement('track');
    track.kind='subtitles'; track.label=sub?.DisplayTitle||'Subtitle'; track.srclang=(sub?.Language||'en').slice(0,2); track.src=blobUrl; track.default=true;
    v.appendChild(track);
    setTimeout(()=>{ const tt=v.textTracks; if(tt.length) tt[tt.length-1].mode='showing'; }, 150);
    toast(`Subtitles: ${sub?.DisplayTitle||'On'}`);
  }catch(e){ toast('This subtitle track is image-based — switching audio/subs needs transcoding','warn'); }
}

// Search & download subtitles online (needs the OpenSubtitles plugin on Jellyfin)
async function searchSubtitles(){
  const cp=APP.curPlay; if(!cp||!cp.itemId){ toast('Start playing something first','warn'); return; }
  const box=document.getElementById('sub-search-results');
  box.innerHTML='<div style="padding:8px;color:var(--text3);font-size:12px;">Searching…</div>';
  try{
    const r=await fetch(`${APP.jellyfinUrl}/Items/${cp.itemId}/RemoteSearch/Subtitles/eng`,{headers:jfHeaders()});
    const results=await r.json();
    if(!Array.isArray(results)||!results.length){
      box.innerHTML='<div style="padding:8px;color:var(--text3);font-size:12px;line-height:1.5;">No subtitles found. Ask Mello to install the <b>OpenSubtitles</b> plugin on the server to enable this.</div>';
      return;
    }
    box.innerHTML=results.slice(0,8).map(s=>`
      <div class="sub-result" onclick="downloadSubtitle('${String(s.Id).replace(/'/g,"\\'")}')">
        <span>${escHtml((s.Name||'Subtitle').slice(0,42))}</span>
        <span style="color:var(--text3);white-space:nowrap;">${escHtml(s.ProviderName||'')} ⬇</span>
      </div>`).join('');
  }catch{ box.innerHTML='<div style="padding:8px;color:#f87171;font-size:12px;">Subtitle search failed.</div>'; }
}
async function downloadSubtitle(subId){
  const cp=APP.curPlay; if(!cp) return;
  toast('Downloading subtitle…','info');
  try{
    const r=await fetch(`${APP.jellyfinUrl}/Items/${cp.itemId}/RemoteSearch/Subtitles/${encodeURIComponent(subId)}`,{method:'POST',headers:jfHeaders()});
    if(!r.ok){ toast('Download failed','error'); return; }
    // Jellyfin needs a moment to attach the new external subtitle; then refresh the list
    setTimeout(async()=>{
      try{
        const ir=await fetch(`${APP.jellyfinUrl}/Users/${APP.jellyfinUserId}/Items/${cp.itemId}?Fields=MediaStreams`,{headers:jfHeaders()});
        const it=await ir.json();
        const subs=(it.MediaStreams||[]).filter(x=>x.Type==='Subtitle');
        cp.subs=subs;
        const subSel=document.getElementById('subtitle-select');
        subSel.innerHTML='<option value="-1">Off</option>'+subs.map(x=>`<option value="${x.Index}">${escHtml(x.DisplayTitle||x.Language||('Track '+x.Index))}</option>`).join('');
        const ext=subs.filter(x=>x.IsExternal);
        if(ext.length){ subSel.value=ext[ext.length-1].Index; changeSubtitle(subSel.value); }
        document.getElementById('sub-search-results').innerHTML='';
        toast('Subtitle added ✓');
      }catch{ toast('Downloaded — reopen the video to use it','info'); }
    },1400);
  }catch{ toast('Download failed','error'); }
}

// Switch audio track by re-negotiating playback at the current position
function changeAudio(idx){
  const cp=APP.curPlay; const np=APP.nowPlaying; if(!cp||!np) return;
  const v=document.getElementById('main-video-player');
  const pos=Math.floor((v.currentTime||0)*1e7);
  const a=(cp.auds||[]).find(s=>s.Index===parseInt(idx));
  toast(`Switching audio to ${a?.DisplayTitle||'track'}…`);
  openJellyfinItem(np.itemId, np.type, np.title, pos, {audioStreamIndex:parseInt(idx)});
}

// ═══════════════════════════
// SEARCH
// ═══════════════════════════
// ═══════════════════════════
// GLOBAL SEARCH
// ═══════════════════════════
function handleSearch(q) {
  if (!q.trim()) {
    // Clear — return to whatever page we were on before searching
    document.getElementById('search-input').value = '';
    const back = APP.preSearchPage || 'home';
    APP.preSearchPage = null;
    navigate(back);
    return;
  }

  // Save the page we came from so we can go back when cleared
  if (APP.currentPage !== 'search') APP.preSearchPage = APP.currentPage;

  // Show search page
  document.querySelectorAll('.page').forEach(p => p.classList.add('hidden'));
  document.querySelectorAll('.nav-link').forEach(n => n.classList.remove('active'));
  document.getElementById('page-search').classList.remove('hidden');
  APP.currentPage = 'search';

  renderSearchResults(q.trim());
}

// Debounced server-side search (scales past the loaded library; falls back to local)
function renderSearchResults(q) {
  document.getElementById('search-query-label').textContent = `"${q}"`;
  document.getElementById('search-results-inner').innerHTML =
    `<div class="nf-grid">${skeletonGrid(6)}</div>`;
  clearTimeout(APP._searchT);
  APP._searchT = setTimeout(() => doSearch(q), 300);
}

async function doSearch(q) {
  const ql = q.toLowerCase();
  let movieItems = [], showItems = [];

  if (APP.jellyfinToken) {
    try {
      const r = await fetch(`${APP.jellyfinUrl}/Users/${APP.jellyfinUserId}/Items?searchTerm=${encodeURIComponent(q)}&IncludeItemTypes=Movie,Series&Recursive=true&Limit=40&Fields=Overview,Genres,CommunityRating,ProductionYear,UserData`, {headers:jfHeaders()});
      if (r.ok) {
        const items = (await r.json()).Items || [];
        movieItems = items.filter(i => i.Type === 'Movie');
        showItems  = items.filter(i => i.Type === 'Series');
      }
    } catch(e) { /* fall through to local */ }
  }
  // Local fallback (server unreachable or empty result set from a flaky call)
  if (!movieItems.length && !showItems.length) {
    movieItems = APP.jfMovies.filter(m => m.Name.toLowerCase().includes(ql));
    showItems  = APP.jfShows.filter(s => s.Name.toLowerCase().includes(ql));
  }

  const gameResults = [];
  Object.entries(GAME_LIBRARY).forEach(([console_key, games]) => {
    games.forEach(g => { if (g.title.toLowerCase().includes(ql)) gameResults.push({...g, console_key}); });
  });

  const inner = document.getElementById('search-results-inner');
  if (APP.currentPage !== 'search') return; // user navigated away mid-search
  const total = movieItems.length + showItems.length + gameResults.length;
  if (!total) {
    inner.innerHTML = `<div class="search-empty"><div class="e-icon">🔍</div><h3>No results for "${escHtml(q)}"</h3><p>Try a different title or check your spelling.</p></div>`;
    return;
  }

  let html = '';
  if (movieItems.length) html += `<div class="search-section"><div class="search-section-label">Movies (${movieItems.length})</div><div class="nf-grid">${movieItems.map(i=>createJellyfinCard(i)).join('')}</div></div>`;
  if (showItems.length)  html += `<div class="search-section"><div class="search-section-label">TV Shows (${showItems.length})</div><div class="nf-grid">${showItems.map(i=>createJellyfinCard(i)).join('')}</div></div>`;
  if (gameResults.length) {
    const chips = gameResults.map(g => `
      <div class="search-game-chip" onclick="openEmulator('${g.console_key}','${g.title}')">
        <span style="font-size:22px;">${g.emoji}</span>
        <div><div style="font-weight:600;">${g.title}</div>
        <div style="font-size:11px;color:var(--text3);">${CONSOLE_NAMES[g.console_key]} · ${g.year}</div></div>
      </div>`).join('');
    html += `<div class="search-section"><div class="search-section-label">Games (${gameResults.length})</div><div class="search-games-wrap">${chips}</div></div>`;
  }
  inner.innerHTML = html;
}

// ═══════════════════════════
// BILLBOARD ROTATION
// ═══════════════════════════
// Build a featured set from the real library (recent items that have artwork + a synopsis)
function buildFeatured(){
  const pool=[...APP.jfMovies,...APP.jfShows].filter(i=>i.Overview);
  // Prefer items with backdrop images for a richer hero
  pool.sort((a,b)=>{
    const ab=(a.BackdropImageTags&&a.BackdropImageTags.length)?1:0;
    const bb=(b.BackdropImageTags&&b.BackdropImageTags.length)?1:0;
    return bb-ab;
  });
  APP.featuredItems = pool.slice(0,6);
}

// Returns the active billboard slide list (real items if loaded, else the built-in fallback)
function bbList(){ return APP.featuredItems.length ? APP.featuredItems : FEATURED; }

function initBillboard() {
  const list = bbList();
  const dotsEl = document.getElementById('bb-dots');
  dotsEl.innerHTML = list.map((_,i) =>
    `<button class="bb-dot${i===0?' active':''}" onclick="jumpBillboard(${i})"></button>`
  ).join('');
  bbIndex = 0;
  renderBillboard(list[0]);
  clearInterval(bbTimer);
  bbTimer = setInterval(() => rotateBillboard(1), 8000);
}

function jumpBillboard(idx) {
  clearInterval(bbTimer);
  bbIndex = idx - 1;
  rotateBillboard(1);
  bbTimer = setInterval(() => rotateBillboard(1), 8000);
}

function rotateBillboard(dir) {
  const list = bbList();
  bbIndex = (bbIndex + dir + list.length) % list.length;
  const content = document.getElementById('bb-content');
  content.style.opacity = '0';
  setTimeout(() => { renderBillboard(list[bbIndex]); content.style.opacity = '1'; }, 380);
}

function renderBillboard(item) {
  const backdrop = document.getElementById('bb-backdrop');
  const art = document.getElementById('bb-art');
  if (item.Id) {
    // Real Jellyfin item
    const genres = item.Genres || [];
    document.getElementById('bb-title').textContent = item.Name;
    document.getElementById('bb-desc').textContent = (item.Overview||'').slice(0,240) + ((item.Overview||'').length>240?'…':'');
    document.getElementById('bb-rating').textContent = item.CommunityRating ? `⭐ ${item.CommunityRating.toFixed(1)}` : 'Featured';
    document.getElementById('bb-year').textContent = item.ProductionYear || '';
    document.getElementById('bb-genre1').textContent = genres[0] || (item.Type==='Series'?'Series':'Movie');
    document.getElementById('bb-genre2').textContent = genres[1] || '';
    document.getElementById('bb-genre2').style.display = genres[1] ? '' : 'none';
    // Backdrop image (fall back to poster)
    const tag = item.BackdropImageTags && item.BackdropImageTags.length;
    const imgUrl = tag
      ? `${APP.jellyfinUrl}/Items/${item.Id}/Images/Backdrop/0?api_key=${APP.jellyfinToken}&maxWidth=1280&quality=90`
      : `${APP.jellyfinUrl}/Items/${item.Id}/Images/Primary?api_key=${APP.jellyfinToken}&maxWidth=1280&quality=90`;
    backdrop.onload = () => backdrop.classList.add('show');
    backdrop.classList.remove('show');
    backdrop.src = imgUrl;
    art.style.display = 'none';
    const isSeries = item.Type==='Series';
    document.getElementById('bb-play-btn').onclick = isSeries
      ? () => openEpisodePicker(item.Id, item.Name)
      : () => openJellyfinItem(item.Id, item.Type, item.Name, item.UserData?.PlaybackPositionTicks||0);
    document.getElementById('bb-info-btn').onclick = () => openDetail(item.Id);
    const bbT=document.getElementById('bb-trailer-btn'); const bbYt=trailerIdFor(item);
    bbT.style.display=bbYt?'':'none'; bbT.onclick=()=>openTrailer(bbYt);
  } else {
    // Built-in fallback slide
    backdrop.classList.remove('show'); backdrop.removeAttribute('src');
    art.style.display = ''; art.textContent = item.emoji;
    document.getElementById('bb-title').textContent = item.title;
    document.getElementById('bb-desc').textContent = item.desc;
    document.getElementById('bb-rating').textContent = item.rating + ' Match';
    document.getElementById('bb-year').textContent = item.year || '';
    document.getElementById('bb-genre1').textContent = item.genre1;
    document.getElementById('bb-genre2').textContent = item.genre2;
    document.getElementById('bb-genre2').style.display = '';
    document.getElementById('bb-play-btn').onclick = () => navigate(item.navTo);
    document.getElementById('bb-info-btn').onclick = () => navigate(item.navTo);
    document.getElementById('bb-trailer-btn').style.display='none';
  }
  document.querySelectorAll('.bb-dot').forEach((d,i) => d.classList.toggle('active', i===bbIndex));
}

// ═══════════════════════════
// MOBILE MENU
// ═══════════════════════════
function toggleMobileMenu() {
  const menu = document.getElementById('mobile-menu');
  const overlay = document.getElementById('mobile-menu-overlay');
  const isOpen = menu.classList.contains('open');
  if (isOpen) { closeMobileMenu(); } else { menu.classList.add('open'); overlay.classList.add('open'); }
}

// Account dropdown opens on click/tap (works on touch, not just hover)
function toggleAvatarMenu(e){
  if (e.target.closest('.nav-avatar-menu')) return; // let menu items handle their own clicks
  e.stopPropagation();
  document.querySelector('.nav-avatar-menu').classList.toggle('open');
}
document.addEventListener('click', () => { const m=document.querySelector('.nav-avatar-menu'); if(m) m.classList.remove('open'); });

function closeMobileMenu() {
  document.getElementById('mobile-menu').classList.remove('open');
  document.getElementById('mobile-menu-overlay').classList.remove('open');
}

function mobileNavigate(page) {
  closeMobileMenu();
  navigate(page);
  document.querySelectorAll('.mob-nav-item').forEach(el => el.classList.remove('active'));
  const el = document.getElementById('mob-nav-' + page);
  if (el) el.classList.add('active');
}

// ═══════════════════════════
// TMDB SETTINGS
// ═══════════════════════════

// Persisted preference toggles
function getSetting(key, def){ const v=localStorage.getItem('mh_set_'+key); return v===null?def:(v==='1'); }
function toggleSetting(el, key){ el.classList.toggle('on'); localStorage.setItem('mh_set_'+key, el.classList.contains('on')?'1':'0'); }
function restoreSettingToggles(){
  const g=document.getElementById('set-gamepad'); if(g) g.classList.toggle('on', getSetting('gamepad', true));
  const v=document.getElementById('set-vgamepad'); if(v) v.classList.toggle('on', getSetting('vgamepad', true));
}

function saveRomBase(){
  const v=document.getElementById('rom-base-input').value.trim().replace(/\/+$/,'');
  if(!v){ toast('Enter your ROM library URL'); return; }
  APP.romBase=v; localStorage.setItem('rom_base',v);
  document.getElementById('rom-status').textContent='✓ ROM library set — click a game to play';
  document.getElementById('rom-base-input').value='';
  toast('ROM library URL saved');
}
function clearRomBase(){
  APP.romBase=''; localStorage.removeItem('rom_base');
  document.getElementById('rom-status').textContent='Cleared — games will ask you to upload a ROM';
  toast('ROM library URL cleared');
}

// ═══════════════════════════
// SETTINGS
// ═══════════════════════════
function editDisplayName(){
  const name=prompt('New display name:',APP.currentUser?.name||'Mello');
  if(name&&name.trim()){
    const n=name.trim();
    if(APP.currentUser){
      APP.currentUser.name=n;
      localStorage.setItem('mv_user', JSON.stringify(APP.currentUser));
    }
    document.getElementById('nav-avatar-initials').textContent=n[0].toUpperCase();
    document.getElementById('avatar-menu-name').textContent=n;
    document.getElementById('settings-display-name').textContent=n;
    toast('Name updated on this device');
  }
}

// ── Invite codes (admin): list + generate via the API ──
async function showAccessCodes(){
  const box=document.getElementById('invite-code-display');
  if(!APP.currentUser || !/admin/i.test(APP.currentUser.role||'')){ box.textContent='Only admins can view invite codes.'; return; }
  box.textContent='Loading…';
  try{
    const r=await fetch(`${API_BASE}/api/invite-codes`, { headers: apiHeaders() });
    const d=await r.json();
    if(!r.ok){ box.textContent=d.error||'Could not load codes.'; return; }
    if(!d.codes.length){ box.innerHTML='No codes yet — click Generate.'; return; }
    box.innerHTML = d.codes.map(c=>{
      const status = c.used_by ? `<span style="color:var(--text3);">· used by ${escHtml(c.used_by)}</span>` : (c.reusable?'<span style="color:#46d369;">· reusable</span>':'<span style="color:#fbbf24;">· unused</span>');
      return `• <strong>${escHtml(c.code)}</strong> ${status}`;
    }).join('<br>');
  }catch(e){ box.textContent='Can’t reach the server.'; }
}

async function generateAccessCode(){
  if(!APP.currentUser || !/admin/i.test(APP.currentUser.role||'')){ toast('Admins only','warn'); return; }
  try{
    const r=await fetch(`${API_BASE}/api/invite-codes`, {
      method:'POST', headers:{'Content-Type':'application/json', ...apiHeaders()},
      body: JSON.stringify({ reusable:false })
    });
    const d=await r.json();
    if(!r.ok){ toast(d.error||'Could not generate code','error'); return; }
    navigator.clipboard?.writeText(d.code);
    toast(`New code ${d.code} (copied)`);
    showAccessCodes();
  }catch(e){ toast('Can’t reach the server','error'); }
}

// ═══════════════════════════
// TOAST
// ═══════════════════════════
function toast(msg, type='success') {
  const el=document.getElementById('toast');
  const icons={success:'✓',warn:'⚠',error:'✕',info:'ℹ'};
  document.getElementById('toast-msg').textContent=msg;
  const ic=document.getElementById('toast-icon'); if(ic) ic.textContent=icons[type]||'';
  el.className=''; el.classList.add('show', type);
  clearTimeout(el._t);
  el._t=setTimeout(()=>el.classList.remove('show'),3200);
}

// ═══════════════════════════
// DESIGN ENHANCEMENTS
// ═══════════════════════════
const jfImg=(id,type,w)=>`${APP.jellyfinUrl}/Items/${id}/Images/${type}?api_key=${APP.jellyfinToken}&maxWidth=${w}&quality=85`;

// ── Accent themes ──
function setTheme(c, c2, el){
  document.documentElement.style.setProperty('--red', c);
  document.documentElement.style.setProperty('--red2', c2);
  localStorage.setItem('mv_theme', JSON.stringify([c,c2]));
  document.querySelectorAll('.theme-swatch').forEach(s=>s.classList.remove('active'));
  if(el) el.classList.add('active'); else { const m=document.querySelector(`.theme-swatch[data-color="${c}"]`); if(m) m.classList.add('active'); }
}
function applyTheme(){
  try{ const t=JSON.parse(localStorage.getItem('mv_theme')||'null'); if(t){ setTheme(t[0],t[1]); } }catch(e){}
}
applyTheme();

// ── Top 10 ──
function renderTop10(){
  const row=document.getElementById('home-top10-row'); const sc=document.getElementById('home-top10-scroll');
  if(!sc) return;
  const all=[...APP.jfMovies,...APP.jfShows].filter(i=>i.CommunityRating).sort((a,b)=>b.CommunityRating-a.CommunityRating).slice(0,10);
  if(all.length<5){ row.style.display='none'; return; }
  sc.innerHTML=all.map((it,i)=>{
    const isS=it.Type==='Series';
    const oc=isS?`openDetail('${it.Id}')`:`openDetail('${it.Id}')`;
    return `<div class="top10-item" onclick="${oc}">
      <div class="top10-num">${i+1}</div>
      <div class="top10-poster">
        <div class="top10-fallback">${isS?'📺':'🎬'}</div>
        <img src="${jfImg(it.Id,'Primary',300)}" loading="lazy" onerror="this.style.display='none'">
      </div></div>`;
  }).join('');
  row.style.display='';
}

// ── Collections (BoxSets) ──
async function renderCollections(){
  const row=document.getElementById('home-collections-row'); const sc=document.getElementById('home-collections-scroll');
  if(!row||!APP.jellyfinToken) return;
  try{
    const r=await fetch(`${APP.jellyfinUrl}/Users/${APP.jellyfinUserId}/Items?IncludeItemTypes=BoxSet&Recursive=true&Fields=ChildCount&SortBy=SortName&Limit=20`,{headers:jfHeaders()});
    const d=await r.json(); const sets=(d.Items||[]).filter(s=>(s.ChildCount||0)>0);
    if(!sets.length){ row.style.display='none'; return; }
    sc.innerHTML=sets.map(s=>`<div class="coll-card" onclick="openCollection('${s.Id}','${(s.Name||'').replace(/'/g,"\\'")}')">
      <img src="${jfImg(s.Id,'Backdrop/0',500)}" loading="lazy" onerror="this.src='${jfImg(s.Id,'Primary',500)}'">
      <div class="coll-card-label">${escHtml(s.Name||'')}</div></div>`).join('');
    row.style.display='';
  }catch{ row.style.display='none'; }
}
async function openCollection(id, name){
  navigate('collection');
  document.getElementById('collection-title').textContent=name;
  const grid=document.getElementById('collection-grid'); grid.innerHTML=skeletonGrid(8);
  try{
    const r=await fetch(`${APP.jellyfinUrl}/Users/${APP.jellyfinUserId}/Items?ParentId=${id}&Fields=Overview,Genres,CommunityRating,ProductionYear,UserData&SortBy=ProductionYear`,{headers:jfHeaders()});
    const d=await r.json();
    grid.innerHTML=(d.Items||[]).map(i=>createJellyfinCard(i)).join('')||'<div class="search-empty"><div class="e-icon">📭</div><h3>Empty collection</h3></div>';
  }catch{ grid.innerHTML='<div class="search-empty"><h3>Could not load</h3></div>'; }
}

// ── Recommended (similar to something you've engaged with) ──
async function renderRecommended(){
  const row=document.getElementById('home-recommended-row'); const sc=document.getElementById('home-recommended-scroll');
  if(!row||!APP.jellyfinToken) return;
  // Jellyfin's similarity is sparse on small libraries, so try several seeds and
  // use the first that returns enough results.
  const topMovies=[...APP.jfMovies].filter(m=>m.CommunityRating).sort((a,b)=>b.CommunityRating-a.CommunityRating);
  const seeds=[APP.jfResume[0], APP.jfFavorites[0], topMovies[0], topMovies[1], topMovies[2], APP.jfMovies[0]].filter(Boolean);
  const seen=new Set();
  for(const seed of seeds){
    if(seen.has(seed.Id)) continue; seen.add(seed.Id);
    try{
      const r=await fetch(`${APP.jellyfinUrl}/Items/${seed.Id}/Similar?userId=${APP.jellyfinUserId}&limit=14&Fields=Overview,Genres,CommunityRating,ProductionYear,UserData`,{headers:jfHeaders()});
      const d=await r.json();
      if(d.Items && d.Items.length>=3){
        sc.innerHTML=d.Items.map(i=>createJellyfinCard(i)).join('');
        row.querySelector('.row-title').textContent=`Because you watched ${seed.Name}`;
        row.style.display=''; return;
      }
    }catch{}
  }
  row.style.display='none';
}

// ── Shuffle / Play Something ──
function shufflePlay(){
  const pool=[...APP.jfMovies, ...APP.jfShows];
  if(!pool.length){ toast('Library still loading…','info'); return; }
  const pick=pool[Math.floor(Math.random()*pool.length)];
  toast(`🎲 ${pick.Name}`,'info');
  if(pick.Type==='Series') openEpisodePicker(pick.Id, pick.Name);
  else openJellyfinItem(pick.Id, pick.Type, pick.Name, pick.UserData?.PlaybackPositionTicks||0);
}

// ── Picture-in-Picture ──
async function togglePiP(){
  const v=document.getElementById('main-video-player');
  try{ if(document.pictureInPictureElement) await document.exitPictureInPicture(); else await v.requestPictureInPicture(); }
  catch(e){ toast('Picture-in-Picture not available','warn'); }
}

// ── Skip Intro (best-effort; needs the Intro Skipper plugin) ──
async function loadIntro(itemId){
  APP.intro=null;
  const btn=document.getElementById('skip-intro-btn'); if(btn) btn.classList.remove('show');
  try{
    const r=await fetch(`${APP.jellyfinUrl}/Episode/${itemId}/IntroTimestamps/v1`,{headers:jfHeaders()});
    if(r.ok){ const d=await r.json(); if(d&&d.Valid){ APP.intro={start:d.IntroStart,end:d.IntroEnd}; } }
  }catch{}
}
function checkIntro(){
  const v=document.getElementById('main-video-player'); const btn=document.getElementById('skip-intro-btn');
  if(!APP.intro||!btn) return;
  const t=v.currentTime;
  btn.classList.toggle('show', t>=APP.intro.start && t<APP.intro.end-1);
}
function doSkipIntro(){ const v=document.getElementById('main-video-player'); if(APP.intro){ v.currentTime=APP.intro.end+0.3; document.getElementById('skip-intro-btn').classList.remove('show'); } }

// ── Trailers (YouTube via Jellyfin RemoteTrailers) ──
function getYouTubeId(url){
  const m=String(url||'').match(/(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/)([\w-]{6,})/);
  return m?m[1]:null;
}
function trailerIdFor(item){
  for(const t of (item.RemoteTrailers||[])){ const id=getYouTubeId(t.Url); if(id) return id; }
  return null;
}
function openTrailer(ytId){
  document.getElementById('trailer-frame').src=`https://www.youtube-nocookie.com/embed/${ytId}?autoplay=1&rel=0`;
  document.getElementById('trailer-modal').classList.remove('hidden');
  pushHistory({modal:'trailer',page:APP.currentPage});
}
function closeTrailer(){
  document.getElementById('trailer-modal').classList.add('hidden');
  document.getElementById('trailer-frame').src='';
}

// ── Rich detail: cast, similar, episodes, details ──
function detailTab(id){
  document.querySelectorAll('.detail-tab').forEach(t=>t.classList.toggle('active', t.dataset.tab===id));
  document.querySelectorAll('.detail-tabpane').forEach(p=>p.classList.toggle('active', p.id==='dtab-'+id));
}
function enrichDetail(item){
  const isSeries=item.Type==='Series';
  // Tabs
  const tabs=[['overview','Overview']];
  if(isSeries) tabs.push(['episodes','Episodes']);
  tabs.push(['similar','More Like This']);
  if((item.People||[]).length) tabs.push(['cast','Cast']);
  tabs.push(['details','Details']);
  document.getElementById('detail-tabs').innerHTML=tabs.map((t,i)=>`<div class="detail-tab${i===0?' active':''}" data-tab="${t[0]}" onclick="detailTab('${t[0]}')">${t[1]}</div>`).join('');
  document.querySelectorAll('.detail-tabpane').forEach(p=>p.classList.remove('active'));
  document.getElementById('dtab-overview').classList.add('active');
  // Cast
  const cast=(item.People||[]).filter(p=>p.Type==='Actor'||p.Type==='Director').slice(0,18);
  document.getElementById('detail-cast').innerHTML=cast.map(p=>{
    const photo=p.PrimaryImageTag?`<img class="cast-photo" src="${jfImg(p.Id,'Primary',150)}" loading="lazy" onerror="this.outerHTML='<div class=cast-photo-fallback>🎭</div>'">`:`<div class="cast-photo-fallback">🎭</div>`;
    return `<div class="cast-card" onclick="openPersonGrid('${p.Id}','${(p.Name||'').replace(/'/g,"\\'")}')">${photo}<div class="cast-name">${escHtml(p.Name||'')}</div><div class="cast-role">${escHtml(p.Role||p.Type||'')}</div></div>`;
  }).join('')||'<div style="color:var(--text3);">No cast info.</div>';
  // Details
  const v=(item.MediaStreams||[]).find(s=>s.Type==='Video')||{};
  const a=(item.MediaStreams||[]).filter(s=>s.Type==='Audio').map(s=>s.DisplayTitle).join(', ');
  const subs=(item.MediaStreams||[]).filter(s=>s.Type==='Subtitle').map(s=>s.Language||s.DisplayTitle).join(', ');
  const rows=[
    ['Genres',(item.Genres||[]).join(', ')],
    ['Year',item.ProductionYear],['Rating',item.OfficialRating],
    ['Community',item.CommunityRating?'⭐ '+item.CommunityRating.toFixed(1):''],
    ['Runtime',item.RunTimeTicks?Math.round(item.RunTimeTicks/600000000)+' min':''],
    ['Video',v.DisplayTitle||(v.Codec?v.Codec.toUpperCase():'')],
    ['Audio',a],['Subtitles',subs],['Container',(item.Container||'').split(',')[0].toUpperCase()]
  ].filter(r=>r[1]);
  document.getElementById('detail-details').innerHTML=rows.map(r=>`<div class="detail-details-row"><span class="ddl">${r[0]}</span><span>${escHtml(String(r[1]))}</span></div>`).join('');
  // Similar (lazy)
  document.getElementById('detail-similar').innerHTML='<div style="color:var(--text3);padding:8px;">Loading…</div>';
  fetch(`${APP.jellyfinUrl}/Items/${item.Id}/Similar?userId=${APP.jellyfinUserId}&limit=12&Fields=CommunityRating,ProductionYear,UserData,Genres,Overview`,{headers:jfHeaders()})
    .then(r=>r.json()).then(d=>{
      const items=d.Items||[];
      document.getElementById('detail-similar').innerHTML=items.length?items.map(i=>`<div class="detail-mini-card" onclick="closeDetail();setTimeout(()=>openDetail('${i.Id}'),60)">${createJellyfinCard(i)}</div>`).join(''):'<div style="color:var(--text3);padding:8px;">Nothing similar found.</div>';
    }).catch(()=>{ document.getElementById('detail-similar').innerHTML='<div style="color:var(--text3);padding:8px;">Could not load.</div>'; });
  // Episodes (series only)
  if(isSeries) loadDetailSeasons(item.Id);
  // Jump straight to a requested tab (e.g. Play on a series card → Episodes)
  if(APP._wantDetailTab && document.getElementById('dtab-'+APP._wantDetailTab)) detailTab(APP._wantDetailTab);
  APP._wantDetailTab=null;
}
async function loadDetailSeasons(seriesId){
  const wrap=document.getElementById('detail-episodes');
  wrap.innerHTML='<div class="ep-spinner"><div class="spin"></div></div>';
  try{
    const r=await fetch(`${APP.jellyfinUrl}/Shows/${seriesId}/Seasons?UserId=${APP.jellyfinUserId}`,{headers:jfHeaders()});
    const seasons=((await r.json()).Items||[]).filter(s=>s.Name);
    if(!seasons.length){ wrap.innerHTML='<div style="color:var(--text3);">No episodes.</div>'; return; }
    wrap.innerHTML=`<div class="ep-season-bar" id="detail-season-bar">${seasons.map((s,i)=>`<button class="ep-season-btn${i===0?' active':''}" onclick="loadDetailEpisodes('${seriesId}','${s.Id}',this)">${escHtml(s.Name)}</button>`).join('')}</div><div class="ep-list" id="detail-ep-list"></div>`;
    loadDetailEpisodes(seriesId, seasons[0].Id, wrap.querySelector('.ep-season-btn'));
  }catch{ wrap.innerHTML='<div style="color:var(--text3);">Could not load seasons.</div>'; }
}
async function loadDetailEpisodes(seriesId, seasonId, btn){
  document.querySelectorAll('#detail-season-bar .ep-season-btn').forEach(b=>b.classList.remove('active')); if(btn) btn.classList.add('active');
  const list=document.getElementById('detail-ep-list'); list.innerHTML='<div class="ep-spinner"><div class="spin"></div></div>';
  try{
    const r=await fetch(`${APP.jellyfinUrl}/Shows/${seriesId}/Episodes?SeasonId=${seasonId}&UserId=${APP.jellyfinUserId}&Fields=Overview,UserData`,{headers:jfHeaders()});
    const eps=(await r.json()).Items||[];
    list.innerHTML=eps.map(ep=>{
      const pct=ep.UserData?.PlayedPercentage||0;
      const ov=ep.Overview?ep.Overview.slice(0,130)+(ep.Overview.length>130?'…':''):'';
      return `<div class="ep-row" onclick="closeDetail(); openJellyfinItem('${ep.Id}','Episode','${(ep.Name||'').replace(/'/g,"\\'")}')">
        <div class="ep-num">${ep.IndexNumber||''}</div>
        <div class="ep-thumb" style="position:relative;"><img src="${jfImg(ep.Id,'Primary',200)}" loading="lazy" onerror="this.style.display='none'"><div class="ep-thumb-play"><svg width="18" height="18" viewBox="0 0 24 24" fill="#fff"><polygon points="5 3 19 12 5 21 5 3"/></svg></div>${pct>0&&pct<100?`<div class="ep-progress-wrap"><div class="ep-progress-fill" style="width:${pct}%"></div></div>`:''}</div>
        <div class="ep-info"><div class="ep-name">${escHtml(ep.Name||'')}</div>${ov?`<div class="ep-overview">${escHtml(ov)}</div>`:''}</div></div>`;
    }).join('')||'<div style="color:var(--text3);padding:20px;">No episodes.</div>';
  }catch{ list.innerHTML='<div style="color:var(--text3);padding:20px;">Could not load.</div>'; }
}

// ── Person filmography ──
async function openPersonGrid(personId, name){
  closeDetail();
  navigate('collection');
  document.getElementById('collection-title').textContent=name;
  const grid=document.getElementById('collection-grid'); grid.innerHTML=skeletonGrid(8);
  try{
    const r=await fetch(`${APP.jellyfinUrl}/Users/${APP.jellyfinUserId}/Items?PersonIds=${personId}&Recursive=true&IncludeItemTypes=Movie,Series&Fields=Overview,Genres,CommunityRating,ProductionYear,UserData&SortBy=ProductionYear&SortOrder=Descending`,{headers:jfHeaders()});
    const d=await r.json();
    grid.innerHTML=(d.Items||[]).map(i=>createJellyfinCard(i)).join('')||'<div class="search-empty"><div class="e-icon">🎭</div><h3>Nothing found</h3></div>';
  }catch{ grid.innerHTML='<div class="search-empty"><h3>Could not load</h3></div>'; }
}

// ── Watch stats ──
function renderStats(){
  const inner=document.getElementById('stats-inner');
  if(!APP.jfMovies.length && !APP.jfShows.length){ inner.innerHTML='<div class="search-empty"><div class="e-icon">📊</div><h3>Connect Jellyfin to see stats</h3></div>'; return; }
  const all=[...APP.jfMovies,...APP.jfShows];
  const watched=all.filter(i=>i.UserData?.Played).length;
  const inProgress=APP.jfResume.length;
  const favs=APP.jfFavorites.length;
  const genreTally={};
  all.forEach(i=>{ if(i.UserData?.Played||i.UserData?.IsFavorite){ (i.Genres||[]).forEach(g=>genreTally[g]=(genreTally[g]||0)+1); } });
  const topGenres=Object.entries(genreTally).sort((a,b)=>b[1]-a[1]).slice(0,6);
  const maxG=topGenres.length?topGenres[0][1]:1;
  inner.innerHTML=`
    <div class="stats-grid">
      <div class="stat-box"><div class="sv">${APP.jfMovies.length}</div><div class="sl">Movies in library</div></div>
      <div class="stat-box"><div class="sv">${APP.jfShows.length}</div><div class="sl">TV Shows</div></div>
      <div class="stat-box"><div class="sv">${watched}</div><div class="sl">Watched</div></div>
      <div class="stat-box"><div class="sv">${inProgress}</div><div class="sl">In progress</div></div>
      <div class="stat-box"><div class="sv">${favs}</div><div class="sl">In My List</div></div>
    </div>
    ${topGenres.length?`<div class="stat-box" style="margin-bottom:0;"><div class="sl" style="margin-bottom:16px;font-weight:700;color:#fff;font-size:15px;">Your Top Genres</div>
      ${topGenres.map(g=>`<div class="stat-bar-row"><div class="stat-bar-label">${escHtml(g[0])}</div><div class="stat-bar-track"><div class="stat-bar-fill" style="width:${Math.round(g[1]/maxG*100)}%"></div></div><div class="stat-bar-val">${g[1]}</div></div>`).join('')}
    </div>`:''}`;
  document.getElementById('stats-sub').textContent = APP.currentUser ? `${APP.currentUser.name}'s activity` : 'Your activity';
}

// ── Admin analytics dashboard ──
async function renderAnalytics(){
  if(!isAdmin()){ navigate('home'); return; }
  const inner=document.getElementById('analytics-inner');
  inner.innerHTML='<div class="stats-grid"><div class="stat-box"><div class="sv">…</div><div class="sl">Loading…</div></div></div>';
  let stats={}, counts={}, sessions=[];
  try{ const r=await fetch(`${API_BASE}/api/admin/stats`,{headers:apiHeaders()}); if(r.ok) stats=await r.json(); }catch{}
  try{ const r=await fetch(`${APP.jellyfinUrl}/Items/Counts`,{headers:jfHeaders()}); if(r.ok) counts=await r.json(); }catch{}
  try{ const r=await fetch(`${API_BASE}/api/sessions`,{headers:apiHeaders()}); if(r.ok) sessions=(await r.json()).sessions||[]; }catch{}
  const all=[...APP.jfMovies,...APP.jfShows];
  const gTally={}; all.forEach(i=>(i.Genres||[]).forEach(g=>gTally[g]=(gTally[g]||0)+1));
  const topGenres=Object.entries(gTally).sort((a,b)=>b[1]-a[1]).slice(0,8);
  const maxG=topGenres.length?topGenres[0][1]:1;
  const rq=stats.requests||{total:0,byStatus:{},byType:{}};
  inner.innerHTML=`
    <div class="stats-grid">
      <div class="stat-box"><div class="sv">${stats.accounts??'—'}</div><div class="sl">Accounts</div></div>
      <div class="stat-box"><div class="sv">${counts.MovieCount??APP.jfMovies.length}</div><div class="sl">Movies</div></div>
      <div class="stat-box"><div class="sv">${counts.SeriesCount??APP.jfShows.length}</div><div class="sl">Series</div></div>
      <div class="stat-box"><div class="sv">${counts.EpisodeCount??'—'}</div><div class="sl">Episodes</div></div>
      <div class="stat-box"><div class="sv">${rq.byStatus.pending||0}</div><div class="sl">Pending requests</div></div>
      <div class="stat-box"><div class="sv">${sessions.length}</div><div class="sl">🔴 Watching now</div></div>
    </div>
    ${topGenres.length?`<div class="stat-box" style="margin-bottom:16px;"><div class="sl" style="margin-bottom:16px;font-weight:700;color:#fff;font-size:15px;">Library by Genre</div>${topGenres.map(g=>`<div class="stat-bar-row"><div class="stat-bar-label">${escHtml(g[0])}</div><div class="stat-bar-track"><div class="stat-bar-fill" style="width:${Math.round(g[1]/maxG*100)}%"></div></div><div class="stat-bar-val">${g[1]}</div></div>`).join('')}</div>`:''}
    <div class="an-two">
      <div class="stat-box"><div class="sl" style="margin-bottom:12px;font-weight:700;color:#fff;font-size:15px;">Requests</div>
        <div class="an-line"><span>Total</span><b>${rq.total}</b></div>
        <div class="an-line"><span>Pending</span><b style="color:#fbbf24;">${rq.byStatus.pending||0}</b></div>
        <div class="an-line"><span>Approved</span><b style="color:#46d369;">${rq.byStatus.approved||0}</b></div>
        <div class="an-line"><span>Added</span><b style="color:var(--red);">${rq.byStatus.added||0}</b></div>
      </div>
      <div class="stat-box"><div class="sl" style="margin-bottom:12px;font-weight:700;color:#fff;font-size:15px;">Newest Accounts</div>
        ${(stats.recentAccounts||[]).map(a=>`<div class="an-line"><span>${escHtml(a.name)} <span style="color:var(--text3);">@${escHtml(a.username)}</span></span><b style="color:var(--text3);font-weight:400;">${a.joined}</b></div>`).join('')||'<div style="color:var(--text3);">No accounts yet.</div>'}
      </div>
    </div>`;
}

// Avatar color from username (for nav + presence personalization)
function applyAvatarColor(){
  if(!APP.currentUser) return;
  const hue=_hashHue(APP.currentUser.username||'x');
  document.querySelectorAll('.nav-avatar, .user-avatar').forEach(el=>{ el.style.background=`linear-gradient(135deg, hsl(${hue} 60% 45%), hsl(${(hue+40)%360} 55% 35%))`; });
}

// ═══════════════════════════
// CUSTOM PLAYER UI (Netflix-style controls)
// ═══════════════════════════
(function initPlayerUI(){
  const v=document.getElementById('main-video-player');
  const ui=document.getElementById('player-ui');
  const cont=document.getElementById('video-player-container');
  const played=document.getElementById('pui-played'), buf=document.getElementById('pui-buf');
  const seek=document.getElementById('pui-seek');
  const timeEl=document.getElementById('pui-time');
  const big=document.getElementById('pui-big');
  const playIc=document.getElementById('pui-play-ic');
  const muteBtn=document.getElementById('pui-mute');
  const vol=document.getElementById('pui-volume');
  const settings=document.getElementById('subtitle-bar');
  let hideT=null;

  const fmt=s=>{ if(!isFinite(s)) s=0; s=Math.floor(s); const hh=Math.floor(s/3600),m=Math.floor(s%3600/60),x=s%60; return (hh?hh+':'+String(m).padStart(2,'0'):m)+':'+String(x).padStart(2,'0'); };

  function paintPlay(){
    const playing=!v.paused&&!v.ended;
    playIc.innerHTML=playing?'<rect x="5" y="3" width="5" height="18"/><rect x="14" y="3" width="5" height="18"/>':'<polygon points="6 3 21 12 6 21 6 3"/>';
    big.classList.toggle('hidden', playing);
    if(playing) queueHide(); else showUI(true);
  }
  function paintTime(){
    const d=v.duration||0, t=v.currentTime||0;
    played.style.width=(d?t/d*100:0)+'%';
    try{ const b=v.buffered; if(b.length&&d) buf.style.width=Math.min(100,(b.end(b.length-1)/d*100))+'%'; }catch(e){}
    timeEl.textContent=fmt(t)+' / '+fmt(d);
  }
  function showUI(sticky){
    ui.classList.add('pui-visible'); ui.classList.remove('pui-nocursor');
    clearTimeout(hideT);
    if(!sticky) queueHide();
  }
  function queueHide(){
    clearTimeout(hideT);
    hideT=setTimeout(()=>{ if(!v.paused && settings.style.display==='none'){ ui.classList.remove('pui-visible'); ui.classList.add('pui-nocursor'); } },3000);
  }
  window.puiShow=()=>showUI(false);

  v.addEventListener('play',paintPlay); v.addEventListener('pause',paintPlay); v.addEventListener('ended',paintPlay);
  v.addEventListener('timeupdate',paintTime); v.addEventListener('progress',paintTime); v.addEventListener('loadedmetadata',paintTime);
  v.addEventListener('volumechange',()=>{ muteBtn.textContent=(v.muted||v.volume===0)?'🔇':'🔊'; vol.value=v.muted?0:v.volume; });

  document.getElementById('pui-play').onclick=()=>{ v.paused?v.play():v.pause(); };
  big.onclick=()=>{ v.paused?v.play():v.pause(); };
  muteBtn.onclick=()=>{ v.muted=!v.muted; };
  vol.oninput=()=>{ v.volume=parseFloat(vol.value); v.muted=(vol.value==0); };
  document.getElementById('pui-settings-btn').onclick=(e)=>{ e.stopPropagation(); settings.style.display=(settings.style.display==='none')?'block':'none'; showUI(true); };
  document.getElementById('pui-fs').onclick=()=>{
    if(document.fullscreenElement) document.exitFullscreen?.();
    else if(cont.requestFullscreen) cont.requestFullscreen().catch(()=>v.webkitEnterFullscreen&&v.webkitEnterFullscreen());
    else if(v.webkitEnterFullscreen) v.webkitEnterFullscreen(); // iPhone Safari
  };

  // Seek: click + drag anywhere on the bar
  let dragging=false;
  function seekTo(e){
    const r=seek.getBoundingClientRect();
    const x=(e.touches?e.touches[0].clientX:e.clientX)-r.left;
    const pct=Math.min(1,Math.max(0,x/r.width));
    if(v.duration) v.currentTime=pct*v.duration;
    paintTime();
  }
  seek.addEventListener('pointerdown',e=>{ dragging=true; try{seek.setPointerCapture(e.pointerId);}catch(_){} seekTo(e); });
  seek.addEventListener('pointermove',e=>{ if(dragging) seekTo(e); });
  seek.addEventListener('pointerup',()=>{ dragging=false; });

  // Activity shows controls; desktop click on video toggles play, touch tap toggles controls
  cont.addEventListener('mousemove',()=>showUI(false));
  let _touchHadUI=false;
  cont.addEventListener('touchstart',()=>{ _touchHadUI=ui.classList.contains('pui-visible'); showUI(false); },{passive:true});
  v.addEventListener('click',()=>{
    if(CAN_HOVER){ v.paused?v.play():v.pause(); }
    else if(_touchHadUI && !v.paused){ ui.classList.remove('pui-visible'); } // second tap hides controls
  });
  v.addEventListener('dblclick',()=>document.getElementById('pui-fs').click());
  cont.addEventListener('click',e=>{ if(settings.style.display!=='none' && !settings.contains(e.target) && e.target.id!=='pui-settings-btn') settings.style.display='none'; });
})();

// ═══════════════════════════
// KEYBOARD / CLOSE
// ═══════════════════════════
document.addEventListener('keydown', e => {
  const videoOpen = !document.getElementById('video-modal').classList.contains('hidden');
  const emuOpen   = !document.getElementById('emulator-modal').classList.contains('hidden');

  const detailOpen = !document.getElementById('detail-modal').classList.contains('hidden');
  const trailerOpen = !document.getElementById('trailer-modal').classList.contains('hidden');

  if (e.key === 'Escape') {
    if (trailerOpen) closeTrailer();
    else if (emuOpen) closeEmulator();
    else if (videoOpen) closeVideo();
    else if (detailOpen) closeDetail();
    else closeMobileMenu();
    return;
  }

  if (videoOpen) {
    const v = document.getElementById('main-video-player');
    if (!v) return;
    switch(e.key) {
      case 'f': case 'F':
        e.preventDefault();
        if (!document.fullscreenElement) document.getElementById('video-player-container').requestFullscreen?.();
        else document.exitFullscreen?.();
        break;
      case 'm': case 'M':
        e.preventDefault();
        v.muted = !v.muted;
        toast(v.muted ? '🔇 Muted' : '🔊 Unmuted');
        break;
      case 'ArrowRight':
        e.preventDefault();
        v.currentTime = Math.min(v.duration||0, v.currentTime + 10);
        toast('⏩ +10s');
        break;
      case 'ArrowLeft':
        e.preventDefault();
        v.currentTime = Math.max(0, v.currentTime - 10);
        toast('⏪ -10s');
        break;
      case ' ':
        e.preventDefault();
        v.paused ? v.play() : v.pause();
        toast(v.paused ? '⏸ Paused' : '▶ Playing');
        break;
    }
  }
});
document.getElementById('video-modal').addEventListener('click',function(e){if(e.target===this)closeVideo();});
document.getElementById('emulator-modal').addEventListener('click',function(e){if(e.target===this)closeEmulator();});
document.getElementById('detail-modal').addEventListener('click',function(e){if(e.target===this)closeDetail();});
document.getElementById('trailer-modal').addEventListener('click',function(e){if(e.target===this)closeTrailer();});

// ═══════════════════════════
// BROWSER HISTORY / BACK BUTTON
// ═══════════════════════════
function pushHistory(state){ try{ history.pushState(state,''); }catch(e){} }

function closeTopModalIfOpen(){
  if(!document.getElementById('video-modal').classList.contains('hidden')){ closeVideo(); return true; }
  if(!document.getElementById('emulator-modal').classList.contains('hidden')){ closeEmulator(); return true; }
  if(!document.getElementById('detail-modal').classList.contains('hidden')){ closeDetail(); return true; }
  return false;
}

window.addEventListener('popstate', e => {
  // Pressing Back first closes any open modal; otherwise returns to the previous page
  if (closeTopModalIfOpen()) return;
  const page = (e.state && e.state.page) || 'home';
  APP._suppressPush = true;
  navigate(page);
  APP._suppressPush = false;
});

console.log('MelloHaven — Login: mello / haven');
</script>
</body>
</html>
