        <p id="emu-ph-msg">Pick a console above and upload a ROM, or set your ROM Library URL in Settings to auto-load games.</p>
        <input type="file" id="rom-file-input" accept=".nes,.sfc,.smc,.n64,.z64,.v64,.md,.bin,.iso,.gba,.gb,.gbc,.cue,.chd,.zip">
        <button class="upload-btn" onclick="document.getElementById('rom-file-input').click()">Upload ROM File</button>
        <p id="emu-ph-path" style="font-size:11px;color:var(--text3);">NES, SNES, N64, Genesis, Dreamcast, PS1, GBA &amp; more</p>
      </div>
    </div>
  </div>
</div>

<!-- VIDEO MODAL -->
<div id="video-modal" class="modal-back hidden">
  <div class="vm-header">
    <div class="vm-title" id="video-modal-title">Now Playing</div>
    <div style="display:flex;gap:8px;align-items:center;">
      <span class="vm-hint">F fullscreen · M mute · ←/→ skip · Space play</span>
      <button class="vm-close" id="vm-pip-btn" onclick="togglePiP()" title="Picture-in-Picture">⧉ PiP</button>
      <button class="vm-close vm-next" id="vm-next-btn" style="display:none;" onclick="playNextNow()">Next Episode ▶</button>
      <button class="vm-close" id="vm-open-jf" onclick="openInJellyfin()">Open in Jellyfin ↗</button>
      <button class="vm-close danger" onclick="closeVideo()">✕ Close</button>
    </div>
  </div>
  <div id="video-player-container">
    <div class="player-prompt" id="video-prompt"><div class="spin"></div><span style="color:var(--text2);font-size:13px;">Loading…</span></div>
    <video id="main-video-player" playsinline webkit-playsinline style="display:none;" onended="onVideoEnded()"></video>

    <!-- Custom Netflix-style controls -->
    <div id="player-ui" class="pui-visible" style="display:none;">
      <div class="pui-top"><span id="pui-title"></span></div>
      <div class="pui-center" id="pui-big">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 21 12 6 21 6 3"/></svg>
      </div>
      <div class="pui-bottom">
        <div class="pui-seek" id="pui-seek">
          <div class="pui-buf" id="pui-buf"></div>
          <div class="pui-played" id="pui-played"><div class="pui-knob"></div></div>
        </div>
        <div class="pui-row">
          <button class="pui-btn" id="pui-play" title="Play/Pause (Space)">
            <svg id="pui-play-ic" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 21 12 6 21 6 3"/></svg>
          </button>
          <button class="pui-btn" id="pui-mute" title="Mute (M)">🔊</button>
          <input type="range" id="pui-volume" min="0" max="1" step="0.05" value="1" title="Volume">
          <span class="pui-time" id="pui-time">0:00 / 0:00</span>
          <div style="flex:1;"></div>
          <button class="pui-btn" id="pui-settings-btn" title="Quality, subtitles & audio">⚙</button>
          <button class="pui-btn" onclick="togglePiP()" title="Picture-in-Picture">⧉</button>
          <button class="pui-btn" id="pui-fs" title="Fullscreen (F)">⛶</button>
        </div>
      </div>
      <div id="subtitle-bar" style="display:none;">
        <div class="pui-set-row"><label>Quality</label>
          <select id="quality-select" onchange="changeQuality(this.value)">
            <option value="original">Original</option>
            <option value="1080">1080p</option>
            <option value="720">720p</option>
            <option value="480">480p (data saver)</option>
          </select></div>
        <div class="pui-set-row"><label>Subtitles</label>
          <select id="subtitle-select" onchange="changeSubtitle(this.value)"><option value="-1">Off</option></select></div>
        <div class="pui-set-row"><label>Audio</label>
          <select id="audio-select" onchange="changeAudio(this.value)"></select></div>
        <div class="pui-set-row"><label>Find Subs</label>
          <button class="pui-subbtn" onclick="searchSubtitles()">🔍 Search online</button></div>
        <div id="sub-search-results" class="sub-results"></div>
      </div>
    </div>

    <button id="skip-intro-btn" onclick="doSkipIntro()">Skip Intro ⏭</button>
    <div id="up-next" class="up-next hidden"></div>
  </div>
</div>

<!-- TRAILER MODAL -->
